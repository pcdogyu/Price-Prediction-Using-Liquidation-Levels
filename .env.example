APP_ADDRESS=:9090
APP_DATABASE=data/liquidation.db
APP_MODEL=models/model.json
APP_SYMBOLS=BTCUSDT,ETHUSDT
APP_BACKFILL_DAYS=180
APP_TRAINING_DAYS=30
APP_SNAPSHOT_INTERVAL=5m
APP_STALE_AFTER=90s
APP_COINGLASS_DEBUG_URL=http://127.0.0.1:9222
APP_COINGLASS_CAPTURE_DIR=data/coinglass-captures
APP_COINGLASS_CAPTURE_INTERVAL=10m
# 报警：监控 Binance USDT 本位成交额前 N 个币对（始终包含 BTCUSDT/ETHUSDT）
APP_ALERT_TOP_SYMBOLS=100
APP_ALERT_WINDOW=3m
# 安静期：预警后该侧继续爆仓只顺延时间，安静期满才发出激进信号
APP_ALERT_QUIET=10m
# 确认窗口：预警后该时间内的反向爆仓把激进信号升级为稳健信号
APP_ALERT_CONFIRM=30m
# 成交额排名刷新间隔
APP_ALERT_REFRESH=10m
# 顺延与反向确认的最小爆仓额（USD），0 表示任意金额都计入
APP_ALERT_FOLLOW_UP_MIN_USD=0
APP_ALERT_OPPOSITE_MIN_USD=0
# 预警阈值（USD）
APP_ALERT_THRESHOLD_BTC_USD=300000
APP_ALERT_THRESHOLD_ETH_USD=250000
APP_ALERT_THRESHOLD_OTHER_USD=300000
# Telegram 通知（也可在 /alerts 页面填写并保存到数据库）
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_CHAT_ID=
# 只在测试环境替换 Telegram API 域名，生产留空使用官方地址
APP_TELEGRAM_API_BASE=https://api.telegram.org

# 仅稳健信号发送到 TradingView 风格下单 webhook；token 与 nonce 不要提交到 Git
APP_STEADY_WEBHOOK_URL=https://tvbot.lmitis.com/tvorder
APP_STEADY_WEBHOOK_API_ID=okx_bot
APP_STEADY_WEBHOOK_TARGET_EXCHANGE=okx
APP_STEADY_WEBHOOK_TRADE_ENV=demo
APP_STEADY_WEBHOOK_EXCHANGE=binance
APP_STEADY_WEBHOOK_INTERVAL=3m
APP_STEADY_WEBHOOK_TOKEN_NONCE=
APP_STEADY_WEBHOOK_TOKEN=
