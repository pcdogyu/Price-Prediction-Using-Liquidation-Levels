[Unit]
Description=CoinGlass lightweight window manager
Requires=coinglass-xvfb.service
After=coinglass-xvfb.service

[Service]
Type=simple
User=liquidation
Group=liquidation
Environment=DISPLAY=:99
Environment=HOME=/var/lib/liquidation-predictor/browser-home
Environment=XDG_CONFIG_HOME=/var/lib/liquidation-predictor/browser-home/.config
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/openbox --sm-disable
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liquidation-predictor /tmp

[Install]
WantedBy=multi-user.target
