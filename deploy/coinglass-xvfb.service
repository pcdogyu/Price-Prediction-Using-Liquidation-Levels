[Unit]
Description=CoinGlass virtual X display
After=network.target

[Service]
Type=simple
User=liquidation
Group=liquidation
Environment=HOME=/var/lib/liquidation-predictor/browser-home
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x900x24 -nolisten tcp -noreset
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liquidation-predictor /tmp

[Install]
WantedBy=multi-user.target
