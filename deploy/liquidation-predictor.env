APP_BASE_PATH=/liquidation/
APP_AUTH_USERNAME=admin
# APP_AUTH_PASSWORD_HASH must be an Argon2id PHC string generated at deployment.
# The tvorder token and nonce are operator-managed secrets.  The upgrade
# script preserves them from the previous environment without committing them.
APP_STEADY_WEBHOOK_URL=https://tvbot.lmitis.com/tvorder
APP_STEADY_WEBHOOK_TARGET_EXCHANGE=binance
APP_STEADY_WEBHOOK_TRADE_ENV=demo
APP_STEADY_WEBHOOK_EXCHANGE=binance
APP_STEADY_WEBHOOK_INTERVAL=3m
APP_TVBOT_CONFIG=/var/lib/liquidation-predictor/tvbot-config.json
