APP_ALERT_TENANTS=/var/lib/liquidation-predictor/alert-tenants
APP_TVBOT_DATA=/opt/tv_okx_bot/data
# If this one-time migration snapshot already exists, the service may import
# it at startup. Releases never create, copy, or back up SQLite databases.
APP_TVBOT_LEGACY_DATABASE=/var/lib/liquidation-predictor/tvbot-legacy-migration.db
APP_TVBOT_LEGACY_DATA=/var/lib/liquidation-predictor
APP_TVBOT_LEGACY_CREDENTIALS_DIR=/var/lib/tv-okx-bot
APP_TVBOT_CREDENTIALS_DIR=/var/lib/liquidation-predictor
APP_UPGRADE_WORKDIR=/opt/Price-Prediction-Using-Liquidation-Levels/source
