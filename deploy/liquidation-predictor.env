APP_ADDRESS=127.0.0.1:9090
APP_DATABASE=/var/lib/liquidation-predictor/liquidation.db
APP_MODEL=/var/lib/liquidation-predictor/model.json
APP_LOG_PATH=/var/lib/liquidation-predictor/logs/application.log
APP_LOG_RETENTION_DAYS=7
APP_BASE_PATH=/liquidation/
APP_AUTH_USERNAME=pcdog
# APP_AUTH_PASSWORD_HASH must be an Argon2id PHC string generated at deployment.
APP_TVBOT_CONFIG=/var/lib/liquidation-predictor/tvbot-config.json
APP_TVBOT_DATA=/opt/tv_okx_bot/data
APP_TVBOT_LEGACY_DATABASE=/opt/tv_okx_bot/data/tvbot.db
APP_TVBOT_LEGACY_DATA=/opt/tv_okx_bot/data
APP_TVBOT_LEGACY_CREDENTIALS_DIR=/var/lib/tv-okx-bot
APP_TVBOT_CREDENTIALS_DIR=/var/lib/liquidation-predictor
APP_UPGRADE_WORKDIR=/opt/Price-Prediction-Using-Liquidation-Levels/source
APP_UPGRADE_BINARY=/opt/Price-Prediction-Using-Liquidation-Levels/liquidation-predictor
APP_UPGRADE_SERVICE=liquidation-predictor.service
APP_UPGRADE_STATUS=/var/lib/liquidation-predictor/upgrade-status.json
APP_SYMBOLS=BTCUSDT,ETHUSDT
APP_BACKFILL_DAYS=180
APP_TRAINING_DAYS=30
APP_SNAPSHOT_INTERVAL=5m
APP_STALE_AFTER=90s
APP_COINGLASS_CAPTURE_INTERVAL=10m
