[Unit]
Description=Persistent CoinGlass browser
Requires=coinglass-xvfb.service
Wants=coinglass-openbox.service
After=network-online.target coinglass-xvfb.service coinglass-openbox.service

[Service]
Type=simple
User=liquidation
Group=liquidation
Environment=DISPLAY=:99
Environment=HOME=/var/lib/liquidation-predictor/browser-home
Environment=XDG_CONFIG_HOME=/var/lib/liquidation-predictor/browser-home/.config
Environment=XDG_CACHE_HOME=/var/lib/liquidation-predictor/browser-home/.cache
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=/var/lib/liquidation-predictor/coinglass-profile --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --window-size=1600,900 --start-maximized --disable-dev-shm-usage --disable-gpu --disable-extensions --no-first-run --no-default-browser-check --disable-session-crashed-bubble --password-store=basic https://www.coinglass.com/pro/futures/LiquidationMap
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liquidation-predictor /tmp

[Install]
WantedBy=multi-user.target
