//@version=5
strategy("Yuhao Vertex Strategy v2.1.1", overlay=true, max_labels_count=500, max_boxes_count=50, max_lines_count=50, pyramiding=0, process_orders_on_close=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// v2.1.1 LMITIS tvorder:
// 1) Webhook URL: https://tvbot.lmitis.com/tvorder.
// 2) Create one TradingView alert with this strategy condition: Order fills only.
// 3) Paste the JSON generated by https://tvbot.lmitis.com/tvbot -> Alert Template into the message box.
// 4) strategy.entry() creates Long/Short orders; {{strategy.order.action}} becomes buy/sell.
// 5) Pine alert() is no longer used for LMITIS trading orders.

//========================
// v1.8.2 更新
// 1) 为了在 TradingView 报警窗口保留 JSON 消息框，移除 alert() 函数报警。
// 2) 本版本只使用策略订单执行报警，消息框可填写 Telegram JSON。
// 3) 报警条件请选择“仅订单执行”，消息框使用 {{strategy.order.alert_message}}。
// 4) 版本号由 v1.8.1 升级到 v1.8.2。
//
// v1.8.1 更新
// 1) Telegram alert_message 增加截图里的信息格式：币种、周期、价格、时间、交易所、条件。
// 2) 同时增加 Direction 字段，明确 LONG / SHORT。
// 3) 保持适合 TradingView 消息框 JSON 使用：{"chat_id":"...","text":"{{strategy.order.alert_message}}"}。
// 4) 版本号由 v1.8.0 升级到 v1.8.1。
//
// v1.8.0 更新
// 1) 支持在 TradingView 报警消息框里保留 JSON。
// 2) strategy.entry() 的 alert_message 改为纯文本方向消息，适合放进 JSON 的 text 字段。
// 3) 如果想在 TradingView 消息框手动填 Telegram JSON，请报警条件选择“仅订单执行”或“订单执行和 alert() 函数调用”。
// 4) 消息框 JSON 可使用 {{strategy.order.alert_message}}，并自动区分 LONG / SHORT。
// 5) 版本号由 v1.7.9 升级到 v1.8.0。
//
// v1.7.9 更新
// 1) Telegram 消息增加方向字段：Direction=LONG / Direction=SHORT。
// 2) Telegram 消息增加 Order=BUY / Order=SELL、Exchange、24H Change、VAH/VAL、POC、Top3 区间等信息。
// 3) 继续保持单行英文纯文本，避免 Telegram 400 Bad Request。
// 4) 版本号由 v1.7.8 升级到 v1.7.9。
//
// v1.7.8 更新
// 1) 修复 Telegram Webhook 仍然 400 Bad Request 的问题。
// 2) Telegram 直连消息改成单行纯 ASCII 文本，不再使用换行、emoji、中文，避免 JSON 被 TradingView 或 Telegram 解析失败。
// 3) Telegram chat_id 使用数字格式发送，适合 -100 开头的群组 ID。
// 4) 版本号由 v1.7.7 升级到 v1.7.8。
//
// v1.7.7 更新
// 1) 修复 Telegram 报警 chat_id 默认为空导致 400 Bad Request 的问题。
// 2) Telegram chat_id 默认填入当前群组：-1003870906955。
// 3) Telegram 文本改为更简洁格式，继续保留 BUY/LONG 和 SELL/SHORT 方向。
// 4) 版本号由 v1.7.6 升级到 v1.7.7。
//
// v1.7.6 更新
// 1) 修复 Telegram JSON 的换行转义，使用 \n 写入 JSON，避免 JSON 因真实换行而失效。
// 2) 版本号由 v1.7.5 升级到 v1.7.6。
//
// v1.7.5 更新
// 1) 新增报警目标选择：Telegram 直连 / 完整 JSON Webhook / 纯文本。
// 2) Telegram 直连模式只发送 Telegram sendMessage 需要的 chat_id 和 text，适合直接填 https://api.telegram.org/bot<TOKEN>/sendMessage。
// 3) 完整 JSON Webhook 模式保留 signal / side / action 等字段，适合发给自己的服务器或交易机器人。
// 4) 版本号由 v1.7.4 升级到 v1.7.5。
//
// v1.7.4 更新
// 1) alert() 消息内置 JSON，不需要在 TradingView 消息框里手动填写 JSON。
// 2) 新增 Webhook JSON 开关、chat_id 输入、报警标题输入。
// 3) JSON 内明确包含 signal / side / action / ticker / timeframe / price / time。
// 4) 版本号由 v1.7.3 升级到 v1.7.4。
//
// v1.7.3 更新
// 1) 报警消息明确区分方向：多单 BUY / LONG，空单 SELL / SHORT。
// 2) 默认关闭通用 Vertex Strong Signal Only 报警，避免收到没有方向的 Any Signal。
// 3) strategy.entry() 增加 alert_message，使用订单成交报警时也能区分 buy / sell。
// 4) 版本号由 v1.7.2 升级到 v1.7.3。
//
// v1.7.2 更新
// 1) 分离“策略回测下单信号”和“实盘报警信号”。
// 2) 新增“报警只在实时K线触发”，默认开启，避免脚本重新编译后历史信号和实盘报警时间看起来错位。
// 3) strategy 继续可以显示历史回测买卖点；alert() 只在实时K线满足条件时发送。
// 4) 移除 strategy 中无效的 alertcondition()，避免 TradingView 提示 alertcondition() has no effect inside strategies。
// 5) 版本号由 v1.7.1 升级到 v1.7.2。
//
// v1.7.1 更新
// 1) 修复 v1.7 没有任何交易信号的问题。
// 2) 原因：成交量最长的三根柱如果直接取全局 Top 3，必然包含 POC 本身，导致“整体在 POC 下方/上方”条件无法成立。
// 3) 改为分别计算 POC 下方最强连续三根合并成交量区间、POC 上方最强连续三根合并成交量区间。
// 4) 多单要求下方三根合并区间有效且整体在 POC 下方；空单要求上方三根合并区间有效且整体在 POC 上方。
// 5) 版本号由 v1.7 升级到 v1.7.1。
//
// v1.7 更新
// 1) 新增 Top 3 成交量柱合并区过滤器。
// 2) 基于当日 VRVP 分桶，找出成交量最大的三根价格分桶柱，并合并为一个区间。
// 3) Strong Buy / 多单信号要求 Top 3 合并成交量柱整体位于当前 POC 下方。
// 4) Strong Sell / 空单信号要求 Top 3 合并成交量柱整体位于当前 POC 上方。
// 5) 新增 Top 3 合并区上下沿状态栏输出与图表显示开关。
// 6) 版本号由 v1.6.1 升级到 v1.7。
//
// v1.6.1 更新
// 1) 修复首根K线数组长度不足时 array.get(1) 越界的问题。
// 2) 过去24小时涨跌幅过滤逻辑保持不变。
//========================

//========================
// 输入参数
//========================
controlPeriod = input.int(14, "Control_Period", minval=1)
signalPeriod  = input.int(5, "Signal_Period", minval=1)
signalMethod  = input.string("SMA", "Signal_Method", options=["SMA", "EMA", "WMA", "RMA"])

bbUpPeriod    = input.int(12, "BB_Up_Period", minval=1)
bbUpDev       = input.float(2.0, "BB_Up_Deviation", step=0.1)

bbDnPeriod    = input.int(12, "BB_Dn_Period", minval=1)
bbDnDev       = input.float(2.0, "BB_Dn_Deviation", step=0.1)

levelOb       = input.float(6.0, "LevelOb", step=0.1)
levelOs       = input.float(-6.0, "LevelOs", step=0.1)

extremeOb     = input.float(10.0, "ExtremelevelOb", step=0.1)
extremeOs     = input.float(-10.0, "ExtremelevelOs", step=0.1)

//========================
// v1.3 信号增强参数
//========================
oscMode          = input.string("ATR", "Oscillator_Mode", options=["ATR", "STDEV"])
atrPeriod        = input.int(14, "ATR_Normalize_Period", minval=1)
useMomentumDecay = input.bool(true, "启用动量衰减过滤")
useVolumeFilter  = input.bool(false, "启用成交量过滤")
volumeMaPeriod   = input.int(20, "Volume_MA_Period", minval=1)
volumeMultiplier = input.float(1.0, "Volume_Multiplier", minval=0.1, step=0.1)
useCooldown      = input.bool(true, "启用连续信号冷却")
cooldownBars     = input.int(8, "信号冷却K线数", minval=0)

//========================
// v1.6 过去24小时涨跌幅过滤
//========================
use24hChangeFilter = input.bool(true, "启用过去24小时涨跌幅过滤")
change24hThreshold = input.float(10.0, "过去24小时涨跌幅过滤阈值 %", minval=0.1, step=0.1)
change24hLookbackHours = input.int(24, "涨跌幅过滤回看小时数", minval=1)

//========================
// 策略交易参数
//========================
enableLongTrade  = input.bool(true, "启用 Strong Buy 做多")
enableShortTrade = input.bool(true, "启用 Strong Sell 做空")
closeOpposite    = input.bool(true, "反向强信号时平掉原方向")
// 交易仓位在 strategy() 的 default_qty_value 中设置为 100% 权益。

//========================
// 时间过滤
//========================
useTimeFilter       = input.bool(true, "启用不开仓时间过滤")
cnTimezone          = input.string("Asia/Shanghai", "上午过滤时区")
blockMorningSession = input.session("0700-0900", "上午不开仓 07:00-09:00")
blockUSOpenSession  = input.session("0930-1030", "美国开盘不开仓 09:30-10:30 NY")

inMorningBlock = not na(time(timeframe.period, blockMorningSession, cnTimezone))
inUSOpenBlock  = not na(time(timeframe.period, blockUSOpenSession, "America/New_York"))
noEntryTime    = useTimeFilter and (inMorningBlock or inUSOpenBlock)

//========================
// 箭头显示
//========================
arrowsVisible          = input.bool(true, "ArrowsVisible")
arrowsOnObOs           = input.bool(true, "显示普通 OBOS 箭头，仅观察，不交易")
arrowsOnExtremeObOs    = input.bool(true, "显示 Strong Buy / Strong Sell 箭头")

useTrendTF2Arrow       = input.bool(true, "Trend TF2 Arrow")
trendTF                = input.timeframe("60", "Trend TF2 Timeframe")
trendLength            = input.int(200, "Trend EMA Length", minval=1)

//========================
// 当日 VRVP / VAH / VAL / POC / Top 3 Volume Zone
//========================
useVRVPFilter = input.bool(true, "强信号启用当日 VRVP VAH/VAL 过滤")
vpRows        = input.int(48, "当日 VRVP Rows", minval=10, maxval=200)
valueAreaPct  = input.float(70.0, "Value Area %", minval=50.0, maxval=99.0, step=1.0)
showVahVal    = input.bool(true, "显示当日 VAH / VAL")

useTop3VolumeZoneFilter = input.bool(true, "启用 Top 3 合并成交量柱相对 POC 过滤")
showTop3VolumeZone      = input.bool(true, "显示 Top 3 合并成交量柱区间")

//========================
// 颜色
//========================
obOsUpColor       = input.color(color.lime, "ArrowsObOsUpColor")
obOsDnColor       = input.color(color.red, "ArrowsObOsDnColor")
extremeUpColor    = input.color(color.blue, "Strong Buy Color")
extremeDnColor    = input.color(color.fuchsia, "Strong Sell Color")
vahColor          = input.color(color.red, "VAH Color")
valColor          = input.color(color.green, "VAL Color")
top3ZoneColor     = input.color(color.purple, "Top 3 Volume Zone Color")

//========================
// 非交易通知
//========================
alertsOn              = input.bool(false, "Enable non-trading alert() notifications")
alertsOnStrongSignals = input.bool(true, "alert() Strong Buy / Strong Sell")
alertsOnCurrent       = input.bool(false, "AlertsOnCurrent / Strong Signal Only 通用报警")
alertsOncePerClose    = input.bool(true, "报警仅K线收盘确认")
alertsRealtimeOnly    = input.bool(true, "报警只在实时K线触发")
alertTarget           = input.string("Text", "alert() Target", options=["Telegram", "Full JSON Webhook", "Text"])
webhookChatId         = input.string("-1003870906955", "Telegram chat_id / Webhook chat_id")
webhookTitle          = input.string("Yuhao Vertex 信号", "Webhook 报警标题")

// orderBarOk 用于策略回测/下单，保留历史回测信号。
// alertBarOk 只用于非交易 alert() 通知；LMITIS 交易订单由 strategy.entry() 的订单成交报警触发。
orderBarOk = alertsOncePerClose ? barstate.isconfirmed : true
alertRealtimeOk = not alertsRealtimeOnly or barstate.isrealtime
alertBarOk = orderBarOk and alertRealtimeOk

//========================
// 均线函数
//========================
ma(src, len, method) =>
    switch method
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "RMA" => ta.rma(src, len)
        => ta.sma(src, len)

//========================
// Vertex Oscillator 核心
// 支持 ATR / STDEV 两种归一化方式
//========================
basis = ta.ema(hlc3, controlPeriod)
dev   = ta.stdev(hlc3, controlPeriod)
atrV  = ta.atr(atrPeriod)
normalizeBase = oscMode == "ATR" ? atrV : dev
zRaw  = normalizeBase != 0 ? (hlc3 - basis) / normalizeBase : 0.0
vertex = zRaw * 5.0
signal = ma(vertex, signalPeriod, signalMethod)

//========================
// Vertex Bollinger Bands
//========================
bbUpBasis = ta.sma(vertex, bbUpPeriod)
bbUpStd   = ta.stdev(vertex, bbUpPeriod)
bbUpper   = bbUpBasis + bbUpStd * bbUpDev

bbDnBasis = ta.sma(vertex, bbDnPeriod)
bbDnStd   = ta.stdev(vertex, bbDnPeriod)
bbLower   = bbDnBasis - bbDnStd * bbDnDev

//========================
// 高周期趋势过滤
//========================
tf2Close = request.security(syminfo.tickerid, trendTF, close, barmerge.gaps_off, barmerge.lookahead_off)
tf2EMA   = request.security(syminfo.tickerid, trendTF, ta.ema(close, trendLength), barmerge.gaps_off, barmerge.lookahead_off)

tf2Bull = tf2Close > tf2EMA
tf2Bear = tf2Close < tf2EMA

allowLongTrend  = not useTrendTF2Arrow or tf2Bull
allowShortTrend = not useTrendTF2Arrow or tf2Bear
allowEntryTime  = not noEntryTime

//========================
// 过滤器
//========================
volMA = ta.sma(volume, volumeMaPeriod)
volumeOk = not useVolumeFilter or volume > volMA * volumeMultiplier

momentumDecayShort = not useMomentumDecay or (vertex < vertex[1] and signal <= signal[1])
momentumDecayLong  = not useMomentumDecay or (vertex > vertex[1] and signal >= signal[1])

var int lastStrongSignalBar = na
cooldownOk = not useCooldown or na(lastStrongSignalBar) or bar_index - lastStrongSignalBar > cooldownBars

//========================
// v1.6 过去24小时涨跌幅计算
//========================
lookbackMs = change24hLookbackHours * 60 * 60 * 1000
var int[] changeTimeArr = array.new_int()
var float[] changeCloseArr = array.new_float()

array.push(changeTimeArr, time)
array.push(changeCloseArr, close)

bool cleaning24hArrays = true
while cleaning24hArrays
    if array.size(changeTimeArr) > 1
        int nextStoredTime = array.get(changeTimeArr, 1)
        if nextStoredTime <= time - lookbackMs
            array.shift(changeTimeArr)
            array.shift(changeCloseArr)
        else
            cleaning24hArrays := false
    else
        cleaning24hArrays := false

hasFull24hData = array.size(changeTimeArr) > 0 and array.get(changeTimeArr, 0) <= time - lookbackMs
close24hBase = array.size(changeCloseArr) > 0 ? array.get(changeCloseArr, 0) : na
change24hPct = hasFull24hData and not na(close24hBase) and close24hBase != 0 ? (close - close24hBase) / close24hBase * 100.0 : na
change24hOk = not use24hChangeFilter or not hasFull24hData or (not na(change24hPct) and math.abs(change24hPct) <= change24hThreshold)

//========================
// 当日 VRVP 计算
// 说明：Pine 无法直接读取 TradingView 右侧内置 VRVP 的 VAH/VAL/POC，
//      这里用当日 K 线成交量按价格分桶近似计算。
// v1.7：额外找出当日 VRVP 中成交量最大的三根分桶柱，并合并成一个价格区间。
//========================
isNewDay = ta.change(time("D")) != 0

var float dayHigh = na
var float dayLow  = na
var float vah     = na
var float val     = na
var float poc     = na
var float top3VolZoneLow  = na
var float top3VolZoneHigh = na
var float top3BelowPocLow  = na
var float top3BelowPocHigh = na
var float top3AbovePocLow  = na
var float top3AbovePocHigh = na
var float[] priceArr = array.new_float()
var float[] volArr   = array.new_float()

if isNewDay or na(dayHigh) or na(dayLow)
    dayHigh := high
    dayLow  := low
    array.clear(priceArr)
    array.clear(volArr)
else
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow, low)

barMidPrice = hlc3
array.push(priceArr, barMidPrice)
array.push(volArr, volume)

f_calc_vp_levels(_prices, _vols, _lo, _hi, _rows, _vaPct) =>
    float _vah = na
    float _val = na
    float _poc = na
    float _top3Low = na
    float _top3High = na
    float _belowLow = na
    float _belowHigh = na
    float _aboveLow = na
    float _aboveHigh = na
    int n = array.size(_prices)
    float priceRange = _hi - _lo
    if n > 0 and priceRange > syminfo.mintick
        float rowH = priceRange / _rows
        float[] bins = array.new_float(_rows, 0.0)
        float totalVol = 0.0
        for i = 0 to n - 1
            float p = array.get(_prices, i)
            float v = array.get(_vols, i)
            int idx = int(math.floor((p - _lo) / rowH))
            idx := math.max(0, math.min(_rows - 1, idx))
            array.set(bins, idx, array.get(bins, idx) + v)
            totalVol += v

        int pocIdx = 0
        float maxVol = array.get(bins, 0)
        for r = 1 to _rows - 1
            float rv = array.get(bins, r)
            if rv > maxVol
                maxVol := rv
                pocIdx := r

        float targetVol = totalVol * _vaPct / 100.0
        float accVol = array.get(bins, pocIdx)
        int lowIdx = pocIdx
        int highIdx = pocIdx

        while accVol < targetVol and (lowIdx > 0 or highIdx < _rows - 1)
            float nextLowVol  = lowIdx > 0 ? array.get(bins, lowIdx - 1) : -1.0
            float nextHighVol = highIdx < _rows - 1 ? array.get(bins, highIdx + 1) : -1.0
            if nextHighVol >= nextLowVol
                highIdx += 1
                accVol += math.max(nextHighVol, 0.0)
            else
                lowIdx -= 1
                accVol += math.max(nextLowVol, 0.0)

        int topIdx1 = -1
        int topIdx2 = -1
        int topIdx3 = -1
        float topVol1 = -1.0
        float topVol2 = -1.0
        float topVol3 = -1.0

        for r = 0 to _rows - 1
            float rv = array.get(bins, r)
            if rv > topVol1
                topVol3 := topVol2
                topIdx3 := topIdx2
                topVol2 := topVol1
                topIdx2 := topIdx1
                topVol1 := rv
                topIdx1 := r
            else if rv > topVol2
                topVol3 := topVol2
                topIdx3 := topIdx2
                topVol2 := rv
                topIdx2 := r
            else if rv > topVol3
                topVol3 := rv
                topIdx3 := r

        if topIdx1 >= 0 and topIdx2 >= 0 and topIdx3 >= 0
            int mergedLowIdx = math.min(topIdx1, math.min(topIdx2, topIdx3))
            int mergedHighIdx = math.max(topIdx1, math.max(topIdx2, topIdx3))
            _top3Low := _lo + mergedLowIdx * rowH
            _top3High := _lo + (mergedHighIdx + 1) * rowH

        // v1.7.1：不要用全局 Top 3 做方向过滤，因为全局 Top 3 会包含 POC。
        // 改为寻找 POC 下方 / 上方各自最强的连续三根成交量柱合并区间。
        if pocIdx >= 3
            float bestBelowVol = -1.0
            int bestBelowStart = na
            for r = 0 to pocIdx - 3
                float clusterVol = array.get(bins, r) + array.get(bins, r + 1) + array.get(bins, r + 2)
                if clusterVol > bestBelowVol
                    bestBelowVol := clusterVol
                    bestBelowStart := r
            if not na(bestBelowStart)
                _belowLow := _lo + bestBelowStart * rowH
                _belowHigh := _lo + (bestBelowStart + 3) * rowH

        if pocIdx <= _rows - 4
            float bestAboveVol = -1.0
            int bestAboveStart = na
            for r = pocIdx + 1 to _rows - 3
                float clusterVol = array.get(bins, r) + array.get(bins, r + 1) + array.get(bins, r + 2)
                if clusterVol > bestAboveVol
                    bestAboveVol := clusterVol
                    bestAboveStart := r
            if not na(bestAboveStart)
                _aboveLow := _lo + bestAboveStart * rowH
                _aboveHigh := _lo + (bestAboveStart + 3) * rowH

        _val := _lo + lowIdx * rowH
        _vah := _lo + (highIdx + 1) * rowH
        _poc := _lo + (pocIdx + 0.5) * rowH
    [_vah, _val, _poc, _top3Low, _top3High, _belowLow, _belowHigh, _aboveLow, _aboveHigh]

[vahCalc, valCalc, pocCalc, top3LowCalc, top3HighCalc, belowLowCalc, belowHighCalc, aboveLowCalc, aboveHighCalc] = f_calc_vp_levels(priceArr, volArr, dayLow, dayHigh, vpRows, valueAreaPct)
vah := vahCalc
val := valCalc
poc := pocCalc
top3VolZoneLow := top3LowCalc
top3VolZoneHigh := top3HighCalc
top3BelowPocLow := belowLowCalc
top3BelowPocHigh := belowHighCalc
top3AbovePocLow := aboveLowCalc
top3AbovePocHigh := aboveHighCalc

priceAboveVAH = not useVRVPFilter or (not na(vah) and close > vah)
priceBelowVAL = not useVRVPFilter or (not na(val) and close < val)

top3BelowPocReady = not na(poc) and not na(top3BelowPocLow) and not na(top3BelowPocHigh)
top3AbovePocReady = not na(poc) and not na(top3AbovePocLow) and not na(top3AbovePocHigh)
// 多单：POC 下方必须存在最强连续三根合并成交量柱，且合并区间整体在当前 POC 下方。
top3ZoneBelowPOC = not useTop3VolumeZoneFilter or (top3BelowPocReady and top3BelowPocHigh < poc)
// 空单：POC 上方必须存在最强连续三根合并成交量柱，且合并区间整体在当前 POC 上方。
top3ZoneAbovePOC = not useTop3VolumeZoneFilter or (top3AbovePocReady and top3AbovePocLow > poc)

//========================
// 信号逻辑
// v1.7.1：Strong Buy / Strong Sell 额外加入 POC 下方/上方最强连续三根成交量柱合并区过滤。
// v1.6：所有信号都必须通过过去24小时涨跌幅过滤。
// v1.5：只有 Strong Buy / Strong Sell 是交易信号。
// 普通 OBOS 信号仅可选显示，不参与交易，不参与 Any Signal 报警。
//========================
obOsUpRaw = arrowsOnObOs and allowEntryTime and change24hOk and allowLongTrend and volumeOk and momentumDecayLong and ta.crossover(vertex, levelOs)
obOsDnRaw = arrowsOnObOs and allowEntryTime and change24hOk and allowShortTrend and volumeOk and momentumDecayShort and ta.crossunder(vertex, levelOb)

// Strong Buy：极端超卖反穿 + 时间允许 + 24小时涨跌幅允许 + 趋势允许 + 价格低于当日 VAL + 动量向上修复 + POC 下方存在最强连续三根成交量柱合并区
strongBuyRaw = allowEntryTime and change24hOk and allowLongTrend and volumeOk and cooldownOk and momentumDecayLong and priceBelowVAL and top3ZoneBelowPOC and ta.crossover(vertex, extremeOs)

// Strong Sell：极端超买反穿 + 时间允许 + 24小时涨跌幅允许 + 趋势允许 + 价格高于当日 VAH + 动量向下衰减 + POC 上方存在最强连续三根成交量柱合并区
strongSellRaw = allowEntryTime and change24hOk and allowShortTrend and volumeOk and cooldownOk and momentumDecayShort and priceAboveVAH and top3ZoneAbovePOC and ta.crossunder(vertex, extremeOb)

// v1.6 Any Signal 只代表通过全部过滤后的 Strong Buy / Strong Sell
anySignalRaw = strongBuyRaw or strongSellRaw

// 用于画图的信号
obOsUpSignal     = arrowsVisible and obOsUpRaw
obOsDnSignal     = arrowsVisible and obOsDnRaw
strongBuySignal  = arrowsVisible and arrowsOnExtremeObOs and strongBuyRaw
strongSellSignal = arrowsVisible and arrowsOnExtremeObOs and strongSellRaw

// 用于策略回测/下单的信号
strongBuyOrder   = orderBarOk and strongBuyRaw
strongSellOrder  = orderBarOk and strongSellRaw
anySignalOrder   = strongBuyOrder or strongSellOrder

// 用于非交易 alert() 通知的信号
strongBuyAlert   = alertBarOk and strongBuyRaw
strongSellAlert  = alertBarOk and strongSellRaw
anySignalAlert   = alertBarOk and anySignalRaw

if anySignalOrder
    lastStrongSignalBar := bar_index

//========================
// 非交易 alert() 通知消息。
// LMITIS tvorder 不走这里；请用 strategy.entry() 订单成交报警，并在 TradingView 消息框粘贴后台生成的 JSON。
// Telegram 直连模式：Webhook URL 填 https://api.telegram.org/bot<TOKEN>/sendMessage，消息只包含 chat_id 和 text。
//========================
longTextMsg = "Vertex Strong Buy | SIDE=BUY | ACTION=LONG | " + syminfo.ticker + " | TF: " + timeframe.period + " | Close: " + str.tostring(close) + " | 24H%: " + str.tostring(change24hPct) + " | VAL: " + str.tostring(val) + " | POC: " + str.tostring(poc) + " | Top3BelowLow: " + str.tostring(top3BelowPocLow) + " | Top3BelowHigh: " + str.tostring(top3BelowPocHigh)
shortTextMsg = "Vertex Strong Sell | SIDE=SELL | ACTION=SHORT | " + syminfo.ticker + " | TF: " + timeframe.period + " | Close: " + str.tostring(close) + " | 24H%: " + str.tostring(change24hPct) + " | VAH: " + str.tostring(vah) + " | POC: " + str.tostring(poc) + " | Top3AboveLow: " + str.tostring(top3AbovePocLow) + " | Top3AboveHigh: " + str.tostring(top3AbovePocHigh)

// longTelegramText = "🚨 Yuhao Vertex 信号 | 📈 方向: LONG / BUY | 📊 币种: " + syminfo.ticker + " | ⏰ 周期: " + timeframe.period + " | 💰 价格: " + str.tostring(close) + " | 🕒 时间: " + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + " | 📊 交易所: " + syminfo.prefix + " | ⚡ 条件: Strong Buy | 24H: " + str.tostring(change24hPct) + "% | VAL: " + str.tostring(val) + " | POC: " + str.tostring(poc) + " | Top3 Below: " + str.tostring(top3BelowPocLow) + " - " + str.tostring(top3BelowPocHigh)
// shortTelegramText = "🚨 Yuhao Vertex 信号 | 📉 方向: SHORT / SELL | 📊 币种: " + syminfo.ticker + " | ⏰ 周期: " + timeframe.period + " | 💰 价格: " + str.tostring(close) + " | 🕒 时间: " + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + " | 📊 交易所: " + syminfo.prefix + " | ⚡ 条件: Strong Sell | 24H: " + str.tostring(change24hPct) + "% | VAH: " + str.tostring(vah) + " | POC: " + str.tostring(poc) + " | Top3 Above: " + str.tostring(top3AbovePocLow) + " - " + str.tostring(top3AbovePocHigh)
longTelegramText = "🚨 Yuhao Vertex 信号\\n📈 方向: LONG / BUY\\n📊 币种: " + syminfo.ticker + "\\n⏰ 周期: " + timeframe.period + "\\n💰 价格: " + str.tostring(close) + "\\n🕒 时间: " + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + "\\n📊 交易所: " + syminfo.prefix + "\\n⚡ 条件: Strong Buy\\n24H: " + str.tostring(change24hPct) + "%\\nVAL: " + str.tostring(val) + "\\nPOC: " + str.tostring(poc) + "\\nTop3 Below: " + str.tostring(top3BelowPocLow) + " - " + str.tostring(top3BelowPocHigh)
shortTelegramText = "🚨 Yuhao Vertex 信号\\n📉 方向: SHORT / SELL\\n📊 币种: " + syminfo.ticker + "\\n⏰ 周期: " + timeframe.period + "\\n💰 价格: " + str.tostring(close) + "\\n🕒 时间: " + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + "\\n📊 交易所: " + syminfo.prefix + "\\n⚡ 条件: Strong Sell\\n24H: " + str.tostring(change24hPct) + "%\\nVAH: " + str.tostring(vah) + "\\nPOC: " + str.tostring(poc) + "\\nTop3 Above: " + str.tostring(top3AbovePocLow) + " - " + str.tostring(top3AbovePocHigh)

longJsonCore = "\"signal\":\"BUY\",\"side\":\"BUY\",\"action\":\"LONG\",\"ticker\":\"" + syminfo.ticker + "\",\"timeframe\":\"" + timeframe.period + "\",\"price\":" + str.tostring(close) + ",\"time\":\"" + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + "\",\"text\":\"" + longTelegramText + "\""
shortJsonCore = "\"signal\":\"SELL\",\"side\":\"SELL\",\"action\":\"SHORT\",\"ticker\":\"" + syminfo.ticker + "\",\"timeframe\":\"" + timeframe.period + "\",\"price\":" + str.tostring(close) + ",\"time\":\"" + str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone) + "\",\"text\":\"" + shortTelegramText + "\""

longFullJsonMsg = webhookChatId == "" ? "{" + longJsonCore + "}" : "{\"chat_id\":\"" + webhookChatId + "\"," + longJsonCore + "}"
shortFullJsonMsg = webhookChatId == "" ? "{" + shortJsonCore + "}" : "{\"chat_id\":\"" + webhookChatId + "\"," + shortJsonCore + "}"

// Telegram sendMessage 直连格式。直接发 Telegram 时，建议只保留 chat_id 和 text。
longTelegramJsonMsg = "{\"chat_id\":" + webhookChatId + ",\"text\":\"" + longTelegramText + "\"}"
shortTelegramJsonMsg = "{\"chat_id\":" + webhookChatId + ",\"text\":\"" + shortTelegramText + "\"}"

longAlertMsg = alertTarget == "Telegram" ? longTelegramJsonMsg : alertTarget == "Full JSON Webhook" ? longFullJsonMsg : longTextMsg
shortAlertMsg = alertTarget == "Telegram" ? shortTelegramJsonMsg : alertTarget == "Full JSON Webhook" ? shortFullJsonMsg : shortTextMsg
anyAlertMsg = strongBuyRaw ? longAlertMsg : strongSellRaw ? shortAlertMsg : "Vertex No Signal"

if alertsOn and alertsOnStrongSignals and strongBuyAlert
    alert(longAlertMsg, alert.freq_once_per_bar)

if alertsOn and alertsOnStrongSignals and strongSellAlert
    alert(shortAlertMsg, alert.freq_once_per_bar)

//========================
// 策略下单
// 只有通过所有过滤器后的 Strong Buy / Strong Sell 触发交易。
// LMITIS tvorder 使用 TradingView 订单成交报警：
// - comment 会填入后台模板的 {{strategy.order.comment}}
// - alert_message 会填入后台模板的 {{strategy.order.alert_message}}
// - {{strategy.order.action}} 由 TradingView 自动输出 buy/sell
// - strategy.close() 禁用订单报警，避免平仓成交被 /tvorder 当成新开仓
//========================
if enableLongTrade and strongBuyOrder
    if closeOpposite
        strategy.close("Short", comment="Close Short on Strong Buy", disable_alert=true)
    strategy.entry("Long", strategy.long, comment="Strong Buy", alert_message="entry_long")

if enableShortTrade and strongSellOrder
    if closeOpposite
        strategy.close("Long", comment="Close Long on Strong Sell", disable_alert=true)
    strategy.entry("Short", strategy.short, comment="Strong Sell", alert_message="entry_short")

//========================
// 画箭头
//========================
plotshape(obOsUpSignal, title="OBOS Up Arrow / Watch Only", style=shape.circle, location=location.belowbar, color=obOsUpColor, size=size.small, text="")
plotshape(obOsDnSignal, title="OBOS Down Arrow / Watch Only", style=shape.circle, location=location.abovebar, color=obOsDnColor, size=size.small, text="")
plotshape(strongBuySignal, title="Strong Buy / Trade Signal", style=shape.circle, location=location.belowbar, color=extremeUpColor, size=size.normal, text="SB")
plotshape(strongSellSignal, title="Strong Sell / Trade Signal", style=shape.circle, location=location.abovebar, color=extremeDnColor, size=size.normal, text="SS")

//========================
// VAH / VAL / Top 3 合并成交量柱区间显示
//========================
plot(showVahVal ? vah : na, title="Daily VRVP VAH", color=vahColor, linewidth=1, style=plot.style_linebr)
plot(showVahVal ? val : na, title="Daily VRVP VAL", color=valColor, linewidth=1, style=plot.style_linebr)
plot(showVahVal ? poc : na, title="Daily VRVP POC", color=color.new(color.white, 0), linewidth=1, style=plot.style_linebr)
plot(showTop3VolumeZone ? top3BelowPocHigh : na, title="Top 3 Below POC Zone High", color=top3ZoneColor, linewidth=1, style=plot.style_linebr)
plot(showTop3VolumeZone ? top3BelowPocLow : na, title="Top 3 Below POC Zone Low", color=top3ZoneColor, linewidth=1, style=plot.style_linebr)
plot(showTop3VolumeZone ? top3AbovePocHigh : na, title="Top 3 Above POC Zone High", color=top3ZoneColor, linewidth=1, style=plot.style_linebr)
plot(showTop3VolumeZone ? top3AbovePocLow : na, title="Top 3 Above POC Zone Low", color=top3ZoneColor, linewidth=1, style=plot.style_linebr)

//========================
// 状态栏输出
//========================
plot(vertex, title="Vertex", color=color.new(color.white, 100), display=display.status_line)
plot(signal, title="Signal", color=color.new(color.yellow, 100), display=display.status_line)
plot(bbUpper, title="BB Upper", color=color.new(color.red, 100), display=display.status_line)
plot(bbLower, title="BB Lower", color=color.new(color.green, 100), display=display.status_line)
plot(noEntryTime ? 1 : 0, title="No Entry Time", color=color.new(color.orange, 100), display=display.status_line)
plot(volumeOk ? 1 : 0, title="Volume OK", color=color.new(color.aqua, 100), display=display.status_line)
plot(cooldownOk ? 1 : 0, title="Cooldown OK", color=color.new(color.purple, 100), display=display.status_line)
plot(change24hPct, title="24H Change %", color=color.new(color.gray, 100), display=display.status_line)
plot(change24hOk ? 1 : 0, title="24H Change OK", color=color.new(color.gray, 100), display=display.status_line)
plot(poc, title="Daily VRVP POC", color=color.new(color.white, 100), display=display.status_line)
plot(top3BelowPocLow, title="Top 3 Below POC Zone Low", color=color.new(color.purple, 100), display=display.status_line)
plot(top3BelowPocHigh, title="Top 3 Below POC Zone High", color=color.new(color.purple, 100), display=display.status_line)
plot(top3AbovePocLow, title="Top 3 Above POC Zone Low", color=color.new(color.purple, 100), display=display.status_line)
plot(top3AbovePocHigh, title="Top 3 Above POC Zone High", color=color.new(color.purple, 100), display=display.status_line)
plot(top3ZoneBelowPOC ? 1 : 0, title="Top 3 Zone Below POC OK", color=color.new(color.lime, 100), display=display.status_line)
plot(top3ZoneAbovePOC ? 1 : 0, title="Top 3 Zone Above POC OK", color=color.new(color.red, 100), display=display.status_line)
plot(strongBuyRaw ? 1 : 0, title="Strong Buy Raw", color=color.new(color.lime, 100), display=display.status_line)
plot(strongSellRaw ? 1 : 0, title="Strong Sell Raw", color=color.new(color.red, 100), display=display.status_line)
plot(anySignalOrder ? 1 : 0, title="Strong Signal Order / Backtest", color=color.new(color.white, 100), display=display.status_line)
plot(anySignalAlert ? 1 : 0, title="Strong Signal Alert / Live", color=color.new(color.white, 100), display=display.status_line)

//========================
// TradingView alert setup for LMITIS tvorder:
// Webhook URL: https://tvbot.lmitis.com/tvorder
// Condition: this strategy -> Order fills only
// Message: paste the JSON generated by https://tvbot.lmitis.com/tvbot -> Alert Template.
// One alert handles both sides because strategy.entry() outputs {{strategy.order.action}} as buy/sell.
// Do not use "Any alert() function call" for /tvorder.
//========================
