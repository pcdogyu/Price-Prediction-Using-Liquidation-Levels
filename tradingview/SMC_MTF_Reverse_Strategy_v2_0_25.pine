//@version=6
// SMC MTF Reverse Strategy version: 2.0.25
// Version rule: every future code change should increase the patch version by 0.0.1.

const string SCRIPT_VERSION = "2.0.25"
const string STRUCTURE_TIMEFRAME = "60"
const string STRUCTURE_LABEL = "1H"

strategy(
     title = "SMC MTF Reverse BOS + OB + FVG Strategy v" + SCRIPT_VERSION,
     shorttitle = "SMC Reverse v" + SCRIPT_VERSION,
     overlay = true,
     max_bars_back = 5000,
     pyramiding = 0,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 1,
     backtest_fill_limits_assumption = 3,

     // VRVP在实时K线内随成交量变化即时刷新。
     // 所有依赖收盘确认的BOS、FVG、开仓与订单块失效逻辑仍使用barstate.isconfirmed。
     calc_on_order_fills = false,
     calc_on_every_tick = true,

     // 订单不在信号K线收盘tick立即成交。
     process_orders_on_close = false,

     // 关闭TradingView模拟器的保证金强制清算。
     // 避免出现非脚本止损导致的Margin call。
     margin_long = 0,
     margin_short = 0,

     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500)

