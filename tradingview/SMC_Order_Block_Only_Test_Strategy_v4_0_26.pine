// =============================================================================
// 当日VRVP计算函数
// =============================================================================

const string VRVP_TIMEZONE = "Asia/Shanghai"
const int VRVP_SESSION_START_HOUR = 8

// 使用每个交易日08:00对应的起始bar_index，避免实时每个tick都向前扫描最多5000根K线。
int vrvpSessionYear = year(time, VRVP_TIMEZONE)
int vrvpSessionMonth = month(time, VRVP_TIMEZONE)
int vrvpSessionDay = dayofmonth(time, VRVP_TIMEZONE)

int vrvpTodaySessionStartTimestamp = timestamp(
     VRVP_TIMEZONE,
     vrvpSessionYear,
     vrvpSessionMonth,
     vrvpSessionDay,
     VRVP_SESSION_START_HOUR,
     0)

bool vrvpInTodaySession =
     time >= vrvpTodaySessionStartTimestamp

var int vrvpSessionStartBarIndex = na

// calc_on_every_tick=true时，仅在新K线第一次计算时维护会话起点。
if barstate.isnew
    bool vrvpFirstSessionBar =
         vrvpInTodaySession and
         (na(time[1]) or time[1] < vrvpTodaySessionStartTimestamp)

    if vrvpFirstSessionBar
        vrvpSessionStartBarIndex := bar_index
    else if not vrvpInTodaySession
        vrvpSessionStartBarIndex := na

f_calculate_today_vrvp_profile(_lookbackBars, _enabled) =>
    float valueAreaLow = na
    float valueAreaHigh = na
    float profileHigh = na
    float profileLow = na
    bool hasTop3ContiguousBlock = false
    float top3BlockLow = na
    float top3BlockHigh = na

    // 非最后一根K线返回空数组，避免历史加载时为每根K线创建完整分布数组。
    array<float> rowVolumes =
         array.new_float(_enabled ? vrvpRowSize : 0, 0.0)

    if _enabled and _lookbackBars > 0
        int safeLookback =
             math.min(_lookbackBars, bar_index + 1)

        // 直接遍历上海时间08:00之后的全部K线求真实最高价和最低价。
        float detectedHigh = na
        float detectedLow = na

        for historyIndex = 0 to safeLookback - 1
            float rangeCandleHigh = high[historyIndex]
            float rangeCandleLow = low[historyIndex]

            if not na(rangeCandleHigh)
                detectedHigh :=
                     na(detectedHigh) ?
                     rangeCandleHigh :
                     math.max(detectedHigh, rangeCandleHigh)

            if not na(rangeCandleLow)
                detectedLow :=
                     na(detectedLow) ?
                     rangeCandleLow :
                     math.min(detectedLow, rangeCandleLow)

        bool validDetectedRange =
             not na(detectedHigh) and
             not na(detectedLow) and
             detectedHigh >= detectedLow

        bool validManualRange =
             not vrvpAutoPriceRange and
             vrvpPriceHigh > vrvpPriceLow

        if validManualRange
            profileHigh := vrvpPriceHigh
            profileLow := vrvpPriceLow
        else if validDetectedRange
            profileHigh := detectedHigh
            profileLow := detectedLow

        // 上下各预留一个最小报价单位，使当日最高价和最低价完整落在分布范围内。
        if not na(profileHigh) and not na(profileLow)
            float rawRange = profileHigh - profileLow

            if rawRange <= 0
                float fallbackHalfRange =
                     math.max(
                         syminfo.mintick * vrvpRowSize * 0.5,
                         syminfo.mintick)

                profileHigh += fallbackHalfRange
                profileLow -= fallbackHalfRange
            else
                profileHigh += syminfo.mintick
                profileLow -= syminfo.mintick

        float rowHeight =
             not na(profileHigh) and not na(profileLow) ?
             (profileHigh - profileLow) / vrvpRowSize :
             na

        if not na(rowHeight) and rowHeight > 0
            for historyIndex = 0 to safeLookback - 1
                float candleHigh = high[historyIndex]
                float candleLow = low[historyIndex]
                float candleVolume = volume[historyIndex]

                if not na(candleHigh) and
                   not na(candleLow) and
                   not na(candleVolume) and
                   candleVolume > 0

                    int startRow = int(math.floor(
                         (candleLow - profileLow) /
                         rowHeight))

                    int endRow = int(math.floor(
                         (candleHigh - profileLow) /
                         rowHeight))

                    startRow :=
                         math.max(
                             0,
                             math.min(vrvpRowSize - 1, startRow))

                    endRow :=
                         math.max(
                             0,
                             math.min(vrvpRowSize - 1, endRow))

                    if startRow <= endRow
                        float coveredRows =
                             endRow - startRow + 1

                        float volumePerRow =
                             candleVolume /
                             coveredRows

                        for rowIndex = startRow to endRow
                            array.set(
                                 rowVolumes,
                                 rowIndex,
                                 array.get(rowVolumes, rowIndex) +
                                 volumePerRow)

            float totalVolume = array.sum(rowVolumes)

            if totalVolume > 0
                array<int> sortedRows =
                     array.sort_indices(
                         rowVolumes,
                         order.descending)

                float targetVolume =
                     totalVolume *
                     vrvpValueAreaPercent /
                     100.0

                float accumulatedVolume = 0.0
                int minimumValueAreaRow = vrvpRowSize - 1
                int maximumValueAreaRow = 0

                for sortedIndex = 0 to vrvpRowSize - 1
                    if accumulatedVolume < targetVolume
                        int currentRow =
                             array.get(sortedRows, sortedIndex)

                        accumulatedVolume +=
                             array.get(rowVolumes, currentRow)

                        minimumValueAreaRow :=
                             math.min(
                                 minimumValueAreaRow,
                                 currentRow)

                        maximumValueAreaRow :=
                             math.max(
                                 maximumValueAreaRow,
                                 currentRow)

                valueAreaLow :=
                     profileLow +
                     minimumValueAreaRow * rowHeight

                valueAreaHigh :=
                     profileLow +
                     (maximumValueAreaRow + 1) * rowHeight

                if array.size(sortedRows) >= 3
                    int topRow1 = array.get(sortedRows, 0)
                    int topRow2 = array.get(sortedRows, 1)
                    int topRow3 = array.get(sortedRows, 2)

                    int minimumTopRow =
                         math.min(
                             topRow1,
                             math.min(topRow2, topRow3))

                    int maximumTopRow =
                         math.max(
                             topRow1,
                             math.max(topRow2, topRow3))

                    hasTop3ContiguousBlock :=
                         maximumTopRow - minimumTopRow == 2

                    if hasTop3ContiguousBlock
                        top3BlockLow :=
                             profileLow +
                             minimumTopRow * rowHeight

                        top3BlockHigh :=
                             profileLow +
                             (maximumTopRow + 1) * rowHeight

    [valueAreaLow, valueAreaHigh, profileHigh, profileLow, hasTop3ContiguousBlock, top3BlockLow, top3BlockHigh, rowVolumes]

// =============================================================================
// 当日VRVP主计算
// 仅在图表最后一根K线上执行完整分布计算，避免加载历史时逐根重复计算。
// =============================================================================

int vrvpLookbackBars =
     enableVrvp and
     barstate.islast and
     vrvpInTodaySession and
     not na(vrvpSessionStartBarIndex) ?
     math.max(0, bar_index - vrvpSessionStartBarIndex + 1) :
     0

[vrvpVal, vrvpVah, vrvpProfileHigh, vrvpProfileLow, vrvpHasTop3Block, vrvpTop3BlockLow, vrvpTop3BlockHigh, vrvpRowVolumes] = f_calculate_today_vrvp_profile(
     vrvpLookbackBars,
     enableVrvp and barstate.islast and vrvpLookbackBars > 0)

// =============================================================================
// 固定1H订单块结构函数
// =============================================================================

f_htf_smc(_structureLength) =>
    ph = ta.pivothigh(high, _structureLength, _structureLength)
    pl = ta.pivotlow(low, _structureLength, _structureLength)

    var float lastSwingHigh = na
    var float lastSwingLow = na

    if not na(ph)
        lastSwingHigh := ph

    if not na(pl)
        lastSwingLow := pl

    bullBos = not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
    bearBos = not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)

    // 看涨订单块候选：最后一根1H阴线。
    var float lastBearTop = na
    var float lastBearBottom = na

    // 看跌订单块候选：最后一根1H阳线。
    var float lastBullTop = na
    var float lastBullBottom = na

    var int bias = 0
    var float obTop = na
    var float obBottom = na
    var float bosLevel = na

    // 先读取此前保存的反向K线，避免把BOS自身误作订单块。
    if bullBos and not na(lastBearTop) and not na(lastBearBottom)
        bias := 1
        obTop := lastBearTop
        obBottom := lastBearBottom
        bosLevel := lastSwingHigh

    if bearBos and not na(lastBullTop) and not na(lastBullBottom)
        bias := -1
        obTop := lastBullTop
        obBottom := lastBullBottom
        bosLevel := lastSwingLow

    if close < open
        lastBearTop := high
        lastBearBottom := low

    if close > open
        lastBullTop := high
        lastBullBottom := low

    [bias, obTop, obBottom, bosLevel, bullBos, bearBos]

// =============================================================================
// 获取固定1H结构数据
// =============================================================================

[structureBias, structureObTop, structureObBottom, structureBosLevel, structureBullBos, structureBearBos] = request.security(
     syminfo.tickerid,
     STRUCTURE_TIMEFRAME,
     f_htf_smc(effectiveHtfStructureLength),
     barmerge.gaps_off,
     barmerge.lookahead_off)

newBullBos =
     barstate.isconfirmed and
     structureBullBos and
     not structureBullBos[1]

newBearBos =
     barstate.isconfirmed and
     structureBearBos and
     not structureBearBos[1]

// =============================================================================
// 订单区块矩形管理
// =============================================================================

var array<box> obBoxes = array.new_box()
var array<box> activeObBoxes = array.new_box()
var array<int> activeObDirections = array.new_int()
var array<float> activeFilterObTops = array.new_float()
var array<float> activeFilterObBottoms = array.new_float()
var array<int> activeFilterObDirections = array.new_int()
var array<int> activeFilterObLeftTimes = array.new_int()
var array<int> activeFilterObRightTimes = array.new_int()

f_price_ranges_touch(_firstTop, _firstBottom, _secondTop, _secondBottom) =>
    float firstHigh = math.max(_firstTop, _firstBottom)
    float firstLow = math.min(_firstTop, _firstBottom)
    float secondHigh = math.max(_secondTop, _secondBottom)
    float secondLow = math.min(_secondTop, _secondBottom)
    math.min(firstHigh, secondHigh) >= math.max(firstLow, secondLow)

f_time_ranges_touch(_firstLeft, _firstRight, _secondLeft, _secondRight) =>
    math.min(_firstRight, _secondRight) >= math.max(_firstLeft, _secondLeft)

f_order_blocks_touch(_firstLeft, _firstRight, _firstTop, _firstBottom, _secondLeft, _secondRight, _secondTop, _secondBottom) =>
    bool timeRangesTouch = f_time_ranges_touch(_firstLeft, _firstRight, _secondLeft, _secondRight)
    bool priceRangesTouch = f_price_ranges_touch(_firstTop, _firstBottom, _secondTop, _secondBottom)
    timeRangesTouch and priceRangesTouch

int currentObStartTime =
     time +
     obHorizontalOffsetMinutes *
     OB_MILLISECOND_PER_MINUTE

int currentObEndTime =
     currentObStartTime +
     obLengthMinutes *
     OB_MILLISECOND_PER_MINUTE

bool hasNewBullOrderBlock =
     newBullBos and
     not na(structureObTop) and
     not na(structureObBottom)

bool hasNewBearOrderBlock =
     newBearBos and
     not na(structureObTop) and
     not na(structureObBottom)

// 新的反向订单块出现时，只终止与新块实际接触的旧方向订单块。
// 同时要求时间区间和价格区间接触/重叠，未碰到的旧块继续向右延伸。
if terminateObOnOpposite and hasNewBullOrderBlock and not hasNewBearOrderBlock
    int oppositeVisualIndex = array.size(activeObBoxes) - 1

    while oppositeVisualIndex >= 0
        int oppositeVisualDirection = array.get(activeObDirections, oppositeVisualIndex)

        if oppositeVisualDirection == -1
            box oppositeVisualBox = array.get(activeObBoxes, oppositeVisualIndex)
            int oppositeVisualLeft = box.get_left(oppositeVisualBox)
            int oppositeVisualRight = box.get_right(oppositeVisualBox)
            float oppositeVisualTop = box.get_top(oppositeVisualBox)
            float oppositeVisualBottom = box.get_bottom(oppositeVisualBox)
            bool oppositeVisualTouchesNewBull =
                 f_order_blocks_touch(
                     oppositeVisualLeft,
                     oppositeVisualRight,
                     oppositeVisualTop,
                     oppositeVisualBottom,
                     currentObStartTime,
                     currentObEndTime,
                     structureObTop,
                     structureObBottom)

            if oppositeVisualTouchesNewBull
                int oppositeTerminationRight =
                     math.max(
                         oppositeVisualLeft + 1,
                         math.min(currentObStartTime, oppositeVisualRight))

                box.set_right(oppositeVisualBox, oppositeTerminationRight)
                array.remove(activeObBoxes, oppositeVisualIndex)
                array.remove(activeObDirections, oppositeVisualIndex)

        oppositeVisualIndex -= 1

    int oppositeFilterIndex = array.size(activeFilterObDirections) - 1

    while oppositeFilterIndex >= 0
        int oppositeFilterDirection = array.get(activeFilterObDirections, oppositeFilterIndex)

        if oppositeFilterDirection == -1
            float oppositeFilterTop = array.get(activeFilterObTops, oppositeFilterIndex)
            float oppositeFilterBottom = array.get(activeFilterObBottoms, oppositeFilterIndex)
            int oppositeFilterLeft = array.get(activeFilterObLeftTimes, oppositeFilterIndex)
            int oppositeFilterRight = array.get(activeFilterObRightTimes, oppositeFilterIndex)
            bool oppositeFilterTouchesNewBull =
                 f_order_blocks_touch(
                     oppositeFilterLeft,
                     oppositeFilterRight,
                     oppositeFilterTop,
                     oppositeFilterBottom,
                     currentObStartTime,
                     currentObEndTime,
                     structureObTop,
                     structureObBottom)

            if oppositeFilterTouchesNewBull
                array.remove(activeFilterObTops, oppositeFilterIndex)
                array.remove(activeFilterObBottoms, oppositeFilterIndex)
                array.remove(activeFilterObDirections, oppositeFilterIndex)
                array.remove(activeFilterObLeftTimes, oppositeFilterIndex)
                array.remove(activeFilterObRightTimes, oppositeFilterIndex)

        oppositeFilterIndex -= 1

if terminateObOnOpposite and hasNewBearOrderBlock and not hasNewBullOrderBlock
    int oppositeVisualIndex = array.size(activeObBoxes) - 1

    while oppositeVisualIndex >= 0
        int oppositeVisualDirection = array.get(activeObDirections, oppositeVisualIndex)

        if oppositeVisualDirection == 1
            box oppositeVisualBox = array.get(activeObBoxes, oppositeVisualIndex)
            int oppositeVisualLeft = box.get_left(oppositeVisualBox)
            int oppositeVisualRight = box.get_right(oppositeVisualBox)
            float oppositeVisualTop = box.get_top(oppositeVisualBox)
            float oppositeVisualBottom = box.get_bottom(oppositeVisualBox)
            bool oppositeVisualTouchesNewBear =
                 f_order_blocks_touch(
                     oppositeVisualLeft,
                     oppositeVisualRight,
                     oppositeVisualTop,
                     oppositeVisualBottom,
                     currentObStartTime,
                     currentObEndTime,
                     structureObTop,
                     structureObBottom)

            if oppositeVisualTouchesNewBear
                int oppositeTerminationRight =
                     math.max(
                         oppositeVisualLeft + 1,
                         math.min(currentObStartTime, oppositeVisualRight))

                box.set_right(oppositeVisualBox, oppositeTerminationRight)
                array.remove(activeObBoxes, oppositeVisualIndex)
                array.remove(activeObDirections, oppositeVisualIndex)

        oppositeVisualIndex -= 1

    int oppositeFilterIndex = array.size(activeFilterObDirections) - 1

    while oppositeFilterIndex >= 0
        int oppositeFilterDirection = array.get(activeFilterObDirections, oppositeFilterIndex)

        if oppositeFilterDirection == 1
            float oppositeFilterTop = array.get(activeFilterObTops, oppositeFilterIndex)
            float oppositeFilterBottom = array.get(activeFilterObBottoms, oppositeFilterIndex)
            int oppositeFilterLeft = array.get(activeFilterObLeftTimes, oppositeFilterIndex)
            int oppositeFilterRight = array.get(activeFilterObRightTimes, oppositeFilterIndex)
            bool oppositeFilterTouchesNewBear =
                 f_order_blocks_touch(
                     oppositeFilterLeft,
                     oppositeFilterRight,
                     oppositeFilterTop,
                     oppositeFilterBottom,
                     currentObStartTime,
                     currentObEndTime,
                     structureObTop,
                     structureObBottom)

            if oppositeFilterTouchesNewBear
                array.remove(activeFilterObTops, oppositeFilterIndex)
                array.remove(activeFilterObBottoms, oppositeFilterIndex)
                array.remove(activeFilterObDirections, oppositeFilterIndex)
                array.remove(activeFilterObLeftTimes, oppositeFilterIndex)
                array.remove(activeFilterObRightTimes, oppositeFilterIndex)

        oppositeFilterIndex -= 1

// 看涨BOS：生成绿色订单块。
if showObBoxes and hasNewBullOrderBlock
    box newBullObBox = box.new(
         left = currentObStartTime,
         top = structureObTop,
         right = currentObEndTime,
         bottom = structureObBottom,
         xloc = xloc.bar_time,
         extend = extend.none,
         border_color = color.new(bullObColor, obBorderTransparency),
         border_width = obBorderWidth,
         bgcolor = color.new(bullObColor, bullObTransparency))

    array.push(obBoxes, newBullObBox)
    array.push(activeObBoxes, newBullObBox)
    array.push(activeObDirections, 1)

// 看跌BOS：生成红色订单块。
if showObBoxes and hasNewBearOrderBlock
    box newBearObBox = box.new(
         left = currentObStartTime,
         top = structureObTop,
         right = currentObEndTime,
         bottom = structureObBottom,
         xloc = xloc.bar_time,
         extend = extend.none,
         border_color = color.new(bearObColor, obBorderTransparency),
         border_width = obBorderWidth,
         bgcolor = color.new(bearObColor, bearObTransparency))

    array.push(obBoxes, newBearObBox)
    array.push(activeObBoxes, newBearObBox)
    array.push(activeObDirections, -1)

if hasNewBullOrderBlock
    array.push(activeFilterObTops, structureObTop)
    array.push(activeFilterObBottoms, structureObBottom)
    array.push(activeFilterObDirections, 1)
    array.push(activeFilterObLeftTimes, currentObStartTime)
    array.push(activeFilterObRightTimes, currentObEndTime)

if hasNewBearOrderBlock
    array.push(activeFilterObTops, structureObTop)
    array.push(activeFilterObBottoms, structureObBottom)
    array.push(activeFilterObDirections, -1)
    array.push(activeFilterObLeftTimes, currentObStartTime)
    array.push(activeFilterObRightTimes, currentObEndTime)

// 仅保留并计算最近N个订单区块。
while array.size(obBoxes) > recentObCount
    box oldObBox = array.shift(obBoxes)
    int oldActiveIndex = array.indexof(activeObBoxes, oldObBox)

    if oldActiveIndex >= 0
        array.remove(activeObBoxes, oldActiveIndex)
        array.remove(activeObDirections, oldActiveIndex)

    box.delete(oldObBox)

int activeFilterObRetentionCount = math.max(recentObCount, obStackHistoryCount)

while array.size(activeFilterObDirections) > activeFilterObRetentionCount
    array.shift(activeFilterObTops)
    array.shift(activeFilterObBottoms)
    array.shift(activeFilterObDirections)
    array.shift(activeFilterObLeftTimes)
    array.shift(activeFilterObRightTimes)

// 已自然到期的活动订单块从数组头部移除。
while array.size(activeObBoxes) > 0 and time >= box.get_right(array.get(activeObBoxes, 0))
    array.shift(activeObBoxes)
    array.shift(activeObDirections)

while array.size(activeFilterObDirections) > 0 and time >= array.get(activeFilterObRightTimes, 0)
    array.shift(activeFilterObTops)
    array.shift(activeFilterObBottoms)
    array.shift(activeFilterObDirections)
    array.shift(activeFilterObLeftTimes)
    array.shift(activeFilterObRightTimes)

// 收盘突破失效，仅检查仍处于活动状态的订单块。
if invalidateObOnClose and barstate.isconfirmed and array.size(activeObBoxes) > 0
    int activeObIndex = array.size(activeObBoxes) - 1

    while activeObIndex >= 0
        box currentObBox = array.get(activeObBoxes, activeObIndex)
        int currentObLeft = box.get_left(currentObBox)

        if time >= currentObLeft
            int currentObDirection = array.get(activeObDirections, activeObIndex)
            float currentObTop = box.get_top(currentObBox)
            float currentObBottom = box.get_bottom(currentObBox)

            bool bullObInvalid =
                 currentObDirection == 1 and
                 close < currentObBottom

            bool bearObInvalid =
                 currentObDirection == -1 and
                 close > currentObTop

            if bullObInvalid or bearObInvalid
                int currentObRight = box.get_right(currentObBox)
                int invalidRight =
                     math.max(
                         currentObLeft + 1,
                         math.min(time, currentObRight))

                box.set_right(currentObBox, invalidRight)
                array.remove(activeObBoxes, activeObIndex)
                array.remove(activeObDirections, activeObIndex)

        activeObIndex -= 1

if invalidateObOnClose and barstate.isconfirmed and array.size(activeFilterObDirections) > 0
    int activeFilterObIndex = array.size(activeFilterObDirections) - 1

    while activeFilterObIndex >= 0
        int currentFilterObLeft = array.get(activeFilterObLeftTimes, activeFilterObIndex)

        if time >= currentFilterObLeft
            int currentFilterObDirection = array.get(activeFilterObDirections, activeFilterObIndex)
            float currentFilterObTop = array.get(activeFilterObTops, activeFilterObIndex)
            float currentFilterObBottom = array.get(activeFilterObBottoms, activeFilterObIndex)

            bool bullFilterObInvalid =
                 currentFilterObDirection == 1 and
                 close < currentFilterObBottom

            bool bearFilterObInvalid =
                 currentFilterObDirection == -1 and
                 close > currentFilterObTop

            if bullFilterObInvalid or bearFilterObInvalid
                array.remove(activeFilterObTops, activeFilterObIndex)
                array.remove(activeFilterObBottoms, activeFilterObIndex)
                array.remove(activeFilterObDirections, activeFilterObIndex)
                array.remove(activeFilterObLeftTimes, activeFilterObIndex)
                array.remove(activeFilterObRightTimes, activeFilterObIndex)

        activeFilterObIndex -= 1

float latestBullFilterObTop = na
float latestBullFilterObBottom = na
float latestBearFilterObTop = na
float latestBearFilterObBottom = na

int latestFilterObIndex = array.size(activeFilterObDirections) - 1

while latestFilterObIndex >= 0 and (na(latestBullFilterObTop) or na(latestBearFilterObBottom))
    int latestFilterObDirection = array.get(activeFilterObDirections, latestFilterObIndex)
    int latestFilterObLeft = array.get(activeFilterObLeftTimes, latestFilterObIndex)
    int latestFilterObRight = array.get(activeFilterObRightTimes, latestFilterObIndex)
    bool latestFilterObAvailable =
         time >= latestFilterObLeft and
         time < latestFilterObRight

    if latestFilterObAvailable
        if latestFilterObDirection == 1 and na(latestBullFilterObTop)
            latestBullFilterObTop := array.get(activeFilterObTops, latestFilterObIndex)
            latestBullFilterObBottom := array.get(activeFilterObBottoms, latestFilterObIndex)

        if latestFilterObDirection == -1 and na(latestBearFilterObBottom)
            latestBearFilterObTop := array.get(activeFilterObTops, latestFilterObIndex)
            latestBearFilterObBottom := array.get(activeFilterObBottoms, latestFilterObIndex)

    latestFilterObIndex -= 1

// =============================================================================
// 多订单块共振结构
// 绿色订单块：从最新向前检查，要求较新的中点逐级高于较旧的中点。
// 红色订单块：从最新向前检查，要求较新的中点逐级低于较旧的中点。
// 按交易频率模式的生效订单块数量检查对应数量的同向订单块。
// =============================================================================

float obStackStepMult = 1.0 + obStackMinStepPct / 100.0

int bullObStackCount = 0
bool bullObStackRising = true
float bullObStackNewestTop = na
float bullObStackNewestBottom = na
float bullObStackPreviousNewerMid = na
int bullObStackNewestLeftTime = na

int bullObStackScanIndex = array.size(activeFilterObDirections) - 1

while bullObStackScanIndex >= 0 and bullObStackCount < effectiveObStackRequiredCount and bullObStackRising
    int bullStackDirection = array.get(activeFilterObDirections, bullObStackScanIndex)
    int bullStackLeftTime = array.get(activeFilterObLeftTimes, bullObStackScanIndex)
    int bullStackRightTime = array.get(activeFilterObRightTimes, bullObStackScanIndex)

    bool bullStackAvailable =
         time >= bullStackLeftTime and
         time < bullStackRightTime

    if bullStackAvailable and bullStackDirection == 1
        float bullStackTop = array.get(activeFilterObTops, bullObStackScanIndex)
        float bullStackBottom = array.get(activeFilterObBottoms, bullObStackScanIndex)
        float bullStackMid = (bullStackTop + bullStackBottom) / 2.0
        bool bullStackTooCloseToUpperBear = false

        if effectiveOppositeObMinGapPct > 0.0
            int bullOppositeIndex = array.size(activeFilterObDirections) - 1
            float nearestUpperBearBottom = na

            while bullOppositeIndex >= 0
                int upperBearDirection = array.get(activeFilterObDirections, bullOppositeIndex)
                int upperBearLeftTime = array.get(activeFilterObLeftTimes, bullOppositeIndex)
                int upperBearRightTime = array.get(activeFilterObRightTimes, bullOppositeIndex)
                bool upperBearAvailable =
                     time >= upperBearLeftTime and
                     time < upperBearRightTime

                if upperBearAvailable and upperBearDirection == -1
                    float upperBearBottom = array.get(activeFilterObBottoms, bullOppositeIndex)
                    float upperBearGap = upperBearBottom - bullStackTop

                    if upperBearGap >= 0.0 and (na(nearestUpperBearBottom) or upperBearBottom < nearestUpperBearBottom)
                        nearestUpperBearBottom := upperBearBottom

                bullOppositeIndex -= 1

            if not na(nearestUpperBearBottom)
                float upperBearGapPct =
                     (nearestUpperBearBottom - bullStackTop) /
                     bullStackTop *
                     100.0
                bullStackTooCloseToUpperBear :=
                     upperBearGapPct >= 0.0 and
                     upperBearGapPct < effectiveOppositeObMinGapPct

        if not bullStackTooCloseToUpperBear
            if bullObStackCount == 0
                bullObStackNewestTop := bullStackTop
                bullObStackNewestBottom := bullStackBottom
                bullObStackNewestLeftTime := bullStackLeftTime
                bullObStackPreviousNewerMid := bullStackMid
                bullObStackCount := 1
            else
                bool bullStepReady =
                     obStackMinStepPct <= 0.0 ?
                     bullObStackPreviousNewerMid > bullStackMid :
                     bullObStackPreviousNewerMid >= bullStackMid * obStackStepMult

                if bullStepReady
                    bullObStackPreviousNewerMid := bullStackMid
                    bullObStackCount += 1
                else
                    bullObStackRising := false

    bullObStackScanIndex -= 1

int bullObStackSelectedCount = bullObStackCount >= effectiveObStackRequiredCount ? effectiveObStackRequiredCount : 0
float bullObStackSelectedDistancePct = bullObStackSelectedCount > 0 ? effectiveObStackMaxDistancePct : na

bullObStackStructureReady =
     bullObStackSelectedCount > 0 and
     not na(bullObStackSelectedDistancePct) and
     not na(bullObStackNewestTop) and
     not na(bullObStackNewestBottom) and
     not na(bullObStackNewestLeftTime)

bullObStackMaxEntryPrice =
     bullObStackStructureReady ?
     bullObStackNewestTop * (1.0 + bullObStackSelectedDistancePct / 100.0) :
     na

bullObStackPriceReady =
     bullObStackStructureReady and
     close >= bullObStackNewestTop and
     close <= bullObStackMaxEntryPrice

int bearObStackCount = 0
bool bearObStackFalling = true
float bearObStackNewestTop = na
float bearObStackNewestBottom = na
float bearObStackPreviousNewerMid = na
int bearObStackNewestLeftTime = na

int bearObStackScanIndex = array.size(activeFilterObDirections) - 1

while bearObStackScanIndex >= 0 and bearObStackCount < effectiveObStackRequiredCount and bearObStackFalling
    int bearStackDirection = array.get(activeFilterObDirections, bearObStackScanIndex)
    int bearStackLeftTime = array.get(activeFilterObLeftTimes, bearObStackScanIndex)
    int bearStackRightTime = array.get(activeFilterObRightTimes, bearObStackScanIndex)

    bool bearStackAvailable =
         time >= bearStackLeftTime and
         time < bearStackRightTime

    if bearStackAvailable and bearStackDirection == -1
        float bearStackTop = array.get(activeFilterObTops, bearObStackScanIndex)
        float bearStackBottom = array.get(activeFilterObBottoms, bearObStackScanIndex)
        float bearStackMid = (bearStackTop + bearStackBottom) / 2.0
        bool bearStackTooCloseToLowerBull = false

        if effectiveOppositeObMinGapPct > 0.0
            int bearOppositeIndex = array.size(activeFilterObDirections) - 1
            float nearestLowerBullTop = na

            while bearOppositeIndex >= 0
                int lowerBullDirection = array.get(activeFilterObDirections, bearOppositeIndex)
                int lowerBullLeftTime = array.get(activeFilterObLeftTimes, bearOppositeIndex)
                int lowerBullRightTime = array.get(activeFilterObRightTimes, bearOppositeIndex)
                bool lowerBullAvailable =
                     time >= lowerBullLeftTime and
                     time < lowerBullRightTime

                if lowerBullAvailable and lowerBullDirection == 1
                    float lowerBullTop = array.get(activeFilterObTops, bearOppositeIndex)
                    float lowerBullGap = bearStackBottom - lowerBullTop

                    if lowerBullGap >= 0.0 and (na(nearestLowerBullTop) or lowerBullTop > nearestLowerBullTop)
                        nearestLowerBullTop := lowerBullTop

                bearOppositeIndex -= 1

            if not na(nearestLowerBullTop)
                float lowerBullGapPct =
                     (bearStackBottom - nearestLowerBullTop) /
                     bearStackBottom *
                     100.0
                bearStackTooCloseToLowerBull :=
                     lowerBullGapPct >= 0.0 and
                     lowerBullGapPct < effectiveOppositeObMinGapPct

        if not bearStackTooCloseToLowerBull
            if bearObStackCount == 0
                bearObStackNewestTop := bearStackTop
                bearObStackNewestBottom := bearStackBottom
                bearObStackNewestLeftTime := bearStackLeftTime
                bearObStackPreviousNewerMid := bearStackMid
                bearObStackCount := 1
            else
                bool bearStepReady =
                     obStackMinStepPct <= 0.0 ?
                     bearStackMid > bearObStackPreviousNewerMid :
                     bearStackMid >= bearObStackPreviousNewerMid * obStackStepMult

                if bearStepReady
                    bearObStackPreviousNewerMid := bearStackMid
                    bearObStackCount += 1
                else
                    bearObStackFalling := false

    bearObStackScanIndex -= 1

int bearObStackSelectedCount = bearObStackCount >= effectiveObStackRequiredCount ? effectiveObStackRequiredCount : 0
float bearObStackSelectedDistancePct = bearObStackSelectedCount > 0 ? effectiveObStackMaxDistancePct : na

bearObStackStructureReady =
     bearObStackSelectedCount > 0 and
     not na(bearObStackSelectedDistancePct) and
     not na(bearObStackNewestTop) and
     not na(bearObStackNewestBottom) and
     not na(bearObStackNewestLeftTime)

bearObStackMinEntryPrice =
     bearObStackStructureReady ?
     bearObStackNewestBottom * (1.0 - bearObStackSelectedDistancePct / 100.0) :
     na

bearObStackPriceReady =
     bearObStackStructureReady and
     close <= bearObStackNewestBottom and
     close >= bearObStackMinEntryPrice

// =============================================================================
// 当前周期FVG过滤
// =============================================================================

bullFvg = not na(high[2]) and low > high[2]
bearFvg = not na(low[2]) and high < low[2]

var int fvgDir = 0
var float fvgTop = na
var float fvgBottom = na
var float fvgMid = na
var int fvgBar = na
var bool fvgUsed = false

if barstate.isconfirmed and bullFvg
    fvgDir := 1
    fvgTop := low
    fvgBottom := high[2]
    fvgMid := (fvgTop + fvgBottom) / 2.0
    fvgBar := bar_index
    fvgUsed := false

if barstate.isconfirmed and bearFvg
    fvgDir := -1
    fvgTop := low[2]
    fvgBottom := high
    fvgMid := (fvgTop + fvgBottom) / 2.0
    fvgBar := bar_index
    fvgUsed := false

fvgTouched =
     not fvgUsed and
     not na(fvgMid) and
     not na(fvgBar) and
     bar_index > fvgBar and
     low <= fvgMid and
     high >= fvgMid

htfLongStructureReady =
     not effectiveHtfStructureFilterEnabled or
     structureBias == 1

htfShortStructureReady =
     not effectiveHtfStructureFilterEnabled or
     structureBias == -1

fvgLongFilterReady =
     not effectiveFvgFilterEnabled or
     (fvgDir == 1 and fvgTouched)

fvgShortFilterReady =
     not effectiveFvgFilterEnabled or
     (fvgDir == -1 and fvgTouched)

// =============================================================================
// 禁止下单时间计算
// 中国窗口固定使用Asia/Shanghai；美国窗口使用America/New_York自动处理夏令时。
// 同时检查当前K线时间和预计成交时间，防止下一根K线在禁止窗口内成交。
// =============================================================================

f_in_china_no_trade_window(_timestamp) =>
    int minuteOfDay =
         hour(_timestamp, "Asia/Shanghai") * 60 +
         minute(_timestamp, "Asia/Shanghai")
    minuteOfDay >= 4 * 60 + 30 and minuteOfDay < 9 * 60

f_in_us_open_no_trade_window(_timestamp) =>
    int minuteOfDay =
         hour(_timestamp, "America/New_York") * 60 +
         minute(_timestamp, "America/New_York")
    minuteOfDay >= 9 * 60 + 30 and minuteOfDay < 10 * 60 + 30

bool chinaNoTradeNow =
     effectiveEnableChinaNoTradeWindow and
     (f_in_china_no_trade_window(time) or f_in_china_no_trade_window(time_close))

bool usOpenNoTradeNow =
     effectiveEnableUsOpenNoTradeWindow and
     (f_in_us_open_no_trade_window(time) or f_in_us_open_no_trade_window(time_close))

bool inNoTradeWindow =
     chinaNoTradeNow or
     usOpenNoTradeNow

// =============================================================================
// 时间换算
// =============================================================================

int hourMilliseconds = 60 * 60 * 1000
int minHoldMilliseconds = int(effectiveMinHoldHours * hourMilliseconds)
int cooldownMilliseconds = int(EXIT_COOLDOWN_HOURS * hourMilliseconds)

// =============================================================================
// 交易状态变量
// =============================================================================

var int cooldownUntil = na
var float activeStop = na
var float activeTarget = na
var int lastProcessedClosedTrade = 0
var float submittedEntryObTop = na
var float submittedEntryObBottom = na
var float submittedEntryVrvpVal = na
var float submittedEntryVrvpVah = na
var float activeEntryVrvpVal = na
var float activeEntryVrvpVah = na
var float activeAutoTarget = na
var int lastBullObStackSignalLeftTime = na
var int lastBullObStackSignalCount = 0
var int lastBearObStackSignalLeftTime = na
var int lastBearObStackSignalCount = 0

// 突破后回踩确认状态。每个“最新订单块+数量”只建立一次等待任务，超时后不重复追单。
var bool bullObRetestArmed = false
var int bullObRetestArmBar = na
var int bullObRetestExpiryBar = na
var int bullObRetestLeftTime = na
var int bullObRetestCount = 0
var float bullObRetestTop = na
var float bullObRetestBottom = na
var int lastBullObRetestSetupLeftTime = na
var int lastBullObRetestSetupCount = 0

var bool bearObRetestArmed = false
var int bearObRetestArmBar = na
var int bearObRetestExpiryBar = na
var int bearObRetestLeftTime = na
var int bearObRetestCount = 0
var float bearObRetestTop = na
var float bearObRetestBottom = na
var int lastBearObRetestSetupLeftTime = na
var int lastBearObRetestSetupCount = 0

bool exitCooldownTriggeredThisBar = false
bool bullObStackLongSignalThisBar = false
bool bearObStackShortSignalThisBar = false

if not na(cooldownUntil) and time >= cooldownUntil
    cooldownUntil := na

inCooldown =
     not na(cooldownUntil) and
     time < cooldownUntil

// 空仓、止盈止损冷静期和禁止下单时间属于订单执行管理，不参与订单块多空方向判断。
baseEntryAllowed =
     not inCooldown and
     not inNoTradeWindow and
     strategy.position_size == 0 and
     strategy.opentrades == 0

if inCooldown
    strategy.cancel_all()

if inNoTradeWindow
    strategy.cancel("做多")
    strategy.cancel("做空")

// =============================================================================
// 订单块数量共振开仓逻辑
// 关闭回踩确认时：保持原来的订单块边界直接突破开仓。
// 开启回踩确认时：第一次突破只建立等待任务，后续回踩边界并重新顺势收盘才开仓。
// =============================================================================

bool validLong = false
bool validShort = false
float validLongObTop = na
float validLongObBottom = na
float validShortObTop = na
float validShortObBottom = na
int validLongObCount = 0
int validShortObCount = 0

bullObStackUnused =
     na(lastBullObStackSignalLeftTime) or
     bullObStackNewestLeftTime != lastBullObStackSignalLeftTime or
     bullObStackSelectedCount != lastBullObStackSignalCount

bearObStackUnused =
     na(lastBearObStackSignalLeftTime) or
     bearObStackNewestLeftTime != lastBearObStackSignalLeftTime or
     bearObStackSelectedCount != lastBearObStackSignalCount

// 原始突破候选：只代表价格已经突破订单块边界，尚不一定立即开仓。
bullObBreakoutCandidate =
     enableBullObStackBuy and
     enableLong and
     majorEmaLongAllowed and
     htfLongStructureReady and
     fvgLongFilterReady and
     barstate.isconfirmed and
     baseEntryAllowed and
     bullObStackStructureReady and
     bullObStackPriceReady and
     bullObStackUnused

bearObBreakoutCandidate =
     enableBearObStackSell and
     enableShort and
     majorEmaShortAllowed and
     htfShortStructureReady and
     fvgShortFilterReady and
     barstate.isconfirmed and
     baseEntryAllowed and
     bearObStackStructureReady and
     bearObStackPriceReady and
     bearObStackUnused

// 新的反向订单块会终止旧方向订单块，因此同步取消对应的回踩等待任务。
if newBearBos
    bullObRetestArmed := false

if newBullBos
    bearObRetestArmed := false

// 已等待的订单块被价格从反方向完全破坏，或等待超时，则放弃该次信号。
if bullObRetestArmed and
   (bar_index > bullObRetestExpiryBar or close < bullObRetestBottom)
    bullObRetestArmed := false

if bearObRetestArmed and
   (bar_index > bearObRetestExpiryBar or close > bearObRetestTop)
    bearObRetestArmed := false

// 同一个最新订单块和数量只建立一次回踩任务，防止超时后在旧订单块上反复追单。
bullRetestSetupUnused =
     na(lastBullObRetestSetupLeftTime) or
     bullObStackNewestLeftTime != lastBullObRetestSetupLeftTime or
     bullObStackSelectedCount != lastBullObRetestSetupCount

bearRetestSetupUnused =
     na(lastBearObRetestSetupLeftTime) or
     bearObStackNewestLeftTime != lastBearObRetestSetupLeftTime or
     bearObStackSelectedCount != lastBearObRetestSetupCount

// 多空在同一根K线同时突破时不建立任何方向的回踩任务。
if enableObRetestConfirmation and bullObBreakoutCandidate and not bearObBreakoutCandidate and bullRetestSetupUnused
    bullObRetestArmed := true
    bullObRetestArmBar := bar_index
    bullObRetestExpiryBar := bar_index + obRetestWaitBars
    bullObRetestLeftTime := bullObStackNewestLeftTime
    bullObRetestCount := bullObStackSelectedCount
    bullObRetestTop := bullObStackNewestTop
    bullObRetestBottom := bullObStackNewestBottom
    lastBullObRetestSetupLeftTime := bullObStackNewestLeftTime
    lastBullObRetestSetupCount := bullObStackSelectedCount

    // 新的多单等待任务出现时，取消尚未完成的空单等待任务。
    bearObRetestArmed := false

if enableObRetestConfirmation and bearObBreakoutCandidate and not bullObBreakoutCandidate and bearRetestSetupUnused
    bearObRetestArmed := true
    bearObRetestArmBar := bar_index
    bearObRetestExpiryBar := bar_index + obRetestWaitBars
    bearObRetestLeftTime := bearObStackNewestLeftTime
    bearObRetestCount := bearObStackSelectedCount
    bearObRetestTop := bearObStackNewestTop
    bearObRetestBottom := bearObStackNewestBottom
    lastBearObRetestSetupLeftTime := bearObStackNewestLeftTime
    lastBearObRetestSetupCount := bearObStackSelectedCount

    // 新的空单等待任务出现时，取消尚未完成的多单等待任务。
    bullObRetestArmed := false

float bullRetestHeight =
     bullObRetestArmed ?
     math.max(bullObRetestTop - bullObRetestBottom, syminfo.mintick) :
     na

float bearRetestHeight =
     bearObRetestArmed ?
     math.max(bearObRetestTop - bearObRetestBottom, syminfo.mintick) :
     na

float bullRetestTouchCeiling =
     bullObRetestArmed ?
     bullObRetestTop + bullRetestHeight * obRetestTolerancePct / 100.0 :
     na

float bearRetestTouchFloor =
     bearObRetestArmed ?
     bearObRetestBottom - bearRetestHeight * obRetestTolerancePct / 100.0 :
     na

bullDirectionCandleReady =
     not obRetestRequireDirectionCandle or close > open

bearDirectionCandleReady =
     not obRetestRequireDirectionCandle or close < open

// 必须在突破后的下一根或更晚K线上完成回踩，不能同一根K线既突破又确认。
bullObRetestConfirmed =
     enableObRetestConfirmation and
     bullObRetestArmed and
     majorEmaLongAllowed and
     htfLongStructureReady and
     barstate.isconfirmed and
     baseEntryAllowed and
     bar_index > bullObRetestArmBar and
     bar_index <= bullObRetestExpiryBar and
     low <= bullRetestTouchCeiling and
     close >= bullObRetestTop and
     close <= bullObRetestTop * (1.0 + effectiveObStackMaxDistancePct / 100.0) and
     bullDirectionCandleReady

bearObRetestConfirmed =
     enableObRetestConfirmation and
     bearObRetestArmed and
     majorEmaShortAllowed and
     htfShortStructureReady and
     barstate.isconfirmed and
     baseEntryAllowed and
     bar_index > bearObRetestArmBar and
     bar_index <= bearObRetestExpiryBar and
     high >= bearRetestTouchFloor and
     close <= bearObRetestBottom and
     close >= bearObRetestBottom * (1.0 - effectiveObStackMaxDistancePct / 100.0) and
     bearDirectionCandleReady

// 关闭回踩确认时使用原始突破候选；开启时仅使用回踩确认结果。
bullObStackCandidate =
     enableObRetestConfirmation ?
     bullObRetestConfirmed :
     bullObBreakoutCandidate

bearObStackCandidate =
     enableObRetestConfirmation ?
     bearObRetestConfirmed :
     bearObBreakoutCandidate

bullObStackLongReady =
     bullObStackCandidate and not bearObStackCandidate

bearObStackShortReady =
     bearObStackCandidate and not bullObStackCandidate

if bullObStackLongReady
    bullObStackLongSignalThisBar := true
    validLong := true
    validLongObTop := enableObRetestConfirmation ? bullObRetestTop : bullObStackNewestTop
    validLongObBottom := enableObRetestConfirmation ? bullObRetestBottom : bullObStackNewestBottom
    lastBullObStackSignalLeftTime := enableObRetestConfirmation ? bullObRetestLeftTime : bullObStackNewestLeftTime
    validLongObCount := enableObRetestConfirmation ? bullObRetestCount : bullObStackSelectedCount
    lastBullObStackSignalCount := validLongObCount
    bullObRetestArmed := false

if bearObStackShortReady
    bearObStackShortSignalThisBar := true
    validShort := true
    validShortObTop := enableObRetestConfirmation ? bearObRetestTop : bearObStackNewestTop
    validShortObBottom := enableObRetestConfirmation ? bearObRetestBottom : bearObStackNewestBottom
    lastBearObStackSignalLeftTime := enableObRetestConfirmation ? bearObRetestLeftTime : bearObStackNewestLeftTime
    validShortObCount := enableObRetestConfirmation ? bearObRetestCount : bearObStackSelectedCount
    lastBearObStackSignalCount := validShortObCount
    bearObRetestArmed := false

// =============================================================================
// 入场信号确认时计算并锁定当日VAL / VAH
// 只在实际提交开仓信号的K线上运行完整VRVP计算，避免历史每根K线重复扫描。
// =============================================================================

int entryVrvpLookbackBars =
     exitMode == "订单块自动" and
     enableValueAreaAutoTarget and
     (validLong or validShort) and
     vrvpInTodaySession and
     not na(vrvpSessionStartBarIndex) ?
     math.max(0, bar_index - vrvpSessionStartBarIndex + 1) :
     0

[entrySignalVrvpVal, entrySignalVrvpVah, entrySignalVrvpProfileHigh, entrySignalVrvpProfileLow, entrySignalVrvpHasTop3Block, entrySignalVrvpTop3BlockLow, entrySignalVrvpTop3BlockHigh, entrySignalVrvpRowVolumes] = f_calculate_today_vrvp_profile(
     entryVrvpLookbackBars,
     entryVrvpLookbackBars > 0)

// =============================================================================
// 提交市价开仓订单
// process_orders_on_close=false：历史回测使用信号下一根K线开盘价成交。
// =============================================================================

if validLong
    submittedEntryObTop := validLongObTop
    submittedEntryObBottom := validLongObBottom
    submittedEntryVrvpVal := entrySignalVrvpVal
    submittedEntryVrvpVah := entrySignalVrvpVah

    string longEntryFillComment =
         "绿" + str.tostring(validLongObCount) + "开多成交"

    strategy.entry(
         id = "做多",
         direction = strategy.long,
         comment = longEntryFillComment,
         alert_message = TVBOT_ENTER_LONG_COMMENT,
         disable_alert = not enableTvbotAlert)

    if effectiveFvgFilterEnabled
        fvgUsed := true

if validShort
    submittedEntryObTop := validShortObTop
    submittedEntryObBottom := validShortObBottom
    submittedEntryVrvpVal := entrySignalVrvpVal
    submittedEntryVrvpVah := entrySignalVrvpVah

    string shortEntryFillComment =
         "红" + str.tostring(validShortObCount) + "开空成交"

    strategy.entry(
         id = "做空",
         direction = strategy.short,
         comment = shortEntryFillComment,
         alert_message = TVBOT_ENTER_SHORT_COMMENT,
         disable_alert = not enableTvbotAlert)

    if effectiveFvgFilterEnabled
        fvgUsed := true

// =============================================================================
// 获取真实模拟成交时间和成交K线
// =============================================================================

hasOpenTrade =
     strategy.opentrades > 0 and
     strategy.position_size != 0

int actualEntryTime = na
int actualEntryBarIndex = na

if hasOpenTrade
    actualEntryTime :=
         strategy.opentrades.entry_time(0)

    actualEntryBarIndex :=
         strategy.opentrades.entry_bar_index(0)

heldMilliseconds =
     hasOpenTrade and not na(actualEntryTime) ?
     time - actualEntryTime :
     0

minimumHoldCompleted =
     hasOpenTrade and
     not na(actualEntryTime) and
     not na(actualEntryBarIndex) and
     time >= actualEntryTime + minHoldMilliseconds and
     bar_index > actualEntryBarIndex

holdingLocked =
     hasOpenTrade and
     not minimumHoldCompleted

// =============================================================================
// 新持仓检测和动态止盈止损价格
// =============================================================================

newLongPosition =
     strategy.position_size > 0 and
     strategy.position_size[1] <= 0

newShortPosition =
     strategy.position_size < 0 and
     strategy.position_size[1] >= 0

positionClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

bufferMult =
     stopBufferBps / 10000.0

var float activeOrderBlockTop = na
var float activeOrderBlockBottom = na

if newLongPosition or newShortPosition
    activeOrderBlockTop := not na(submittedEntryObTop) ? submittedEntryObTop : structureObTop
    activeOrderBlockBottom := not na(submittedEntryObBottom) ? submittedEntryObBottom : structureObBottom
    activeEntryVrvpVal := submittedEntryVrvpVal
    activeEntryVrvpVah := submittedEntryVrvpVah
    activeAutoTarget := na

    float filledEntryPrice = strategy.position_avg_price

    // 自动止盈优先级1：当日值区边界。
    // 使用信号确认K线计算并锁定的VAL/VAH，再用真实模拟成交价判断是否在边界附近。
    float lockedValueAreaWidth =
         not na(activeEntryVrvpVal) and
         not na(activeEntryVrvpVah) and
         activeEntryVrvpVah > activeEntryVrvpVal ?
         activeEntryVrvpVah - activeEntryVrvpVal :
         na

    float lockedValueAreaTolerance =
         not na(lockedValueAreaWidth) ?
         math.max(
             syminfo.mintick,
             lockedValueAreaWidth * valueAreaEntryTolerancePct / 100.0) :
         na

    bool longEntryNearVal =
         exitMode == "订单块自动" and
         enableValueAreaAutoTarget and
         newLongPosition and
         not na(lockedValueAreaTolerance) and
         math.abs(filledEntryPrice - activeEntryVrvpVal) <= lockedValueAreaTolerance and
         activeEntryVrvpVah > filledEntryPrice

    bool shortEntryNearVah =
         exitMode == "订单块自动" and
         enableValueAreaAutoTarget and
         newShortPosition and
         not na(lockedValueAreaTolerance) and
         math.abs(filledEntryPrice - activeEntryVrvpVah) <= lockedValueAreaTolerance and
         activeEntryVrvpVal < filledEntryPrice

    if longEntryNearVal
        activeAutoTarget := activeEntryVrvpVah

    if shortEntryNearVah
        activeAutoTarget := activeEntryVrvpVal

    // 自动止盈优先级2：未触发值区规则时，锁定最近的对向订单块目标。
    // 多单：选择开仓价上方最近红色订单块的下沿。
    // 空单：选择开仓价下方最近绿色订单块的上沿。
    if na(activeAutoTarget)
        int targetSearchIndex = array.size(activeFilterObDirections) - 1

        while targetSearchIndex >= 0
            int targetObDirection = array.get(activeFilterObDirections, targetSearchIndex)
            int targetObLeftTime = array.get(activeFilterObLeftTimes, targetSearchIndex)
            int targetObRightTime = array.get(activeFilterObRightTimes, targetSearchIndex)
            float targetObTop = array.get(activeFilterObTops, targetSearchIndex)
            float targetObBottom = array.get(activeFilterObBottoms, targetSearchIndex)

            bool targetObAvailable =
                 time >= targetObLeftTime and
                 time < targetObRightTime

            if targetObAvailable and newLongPosition and targetObDirection == -1 and targetObBottom > filledEntryPrice
                activeAutoTarget :=
                     na(activeAutoTarget) ?
                     targetObBottom :
                     math.min(activeAutoTarget, targetObBottom)

            if targetObAvailable and newShortPosition and targetObDirection == 1 and targetObTop < filledEntryPrice
                activeAutoTarget :=
                     na(activeAutoTarget) ?
                     targetObTop :
                     math.max(activeAutoTarget, targetObTop)

            targetSearchIndex -= 1

    submittedEntryObTop := na
    submittedEntryObBottom := na
    submittedEntryVrvpVal := na
    submittedEntryVrvpVah := na

if strategy.position_size > 0
    entryPrice =
         strategy.position_avg_price

    percentStop =
         entryPrice *
         (1.0 - stopLossPct / 100.0)

    percentTarget =
         entryPrice *
         (1.0 + takeProfitPct / 100.0)

    minimumAutoTarget =
         entryPrice *
         (1.0 + effectiveAutoTargetMinDistancePct / 100.0)

    autoTargetReady =
         not na(activeAutoTarget) and
         activeAutoTarget > entryPrice and
         (effectiveAutoTargetMinDistancePct <= 0.0 or activeAutoTarget >= minimumAutoTarget)

    orderBlockStop =
         not na(activeOrderBlockBottom) and activeOrderBlockBottom < entryPrice ?
         activeOrderBlockBottom * (1.0 - bufferMult) :
         percentStop

    orderBlockTarget =
         autoTargetReady ?
         activeAutoTarget :
         percentTarget

    activeStop :=
         exitMode == "订单块自动" ?
         orderBlockStop :
         percentStop

    activeTarget :=
         exitMode == "订单块自动" ?
         orderBlockTarget :
         percentTarget

else if strategy.position_size < 0
    entryPrice =
         strategy.position_avg_price

    percentStop =
         entryPrice *
         (1.0 + stopLossPct / 100.0)

    percentTarget =
         entryPrice *
         (1.0 - takeProfitPct / 100.0)

    maximumAutoTarget =
         entryPrice *
         (1.0 - effectiveAutoTargetMinDistancePct / 100.0)

    autoTargetReady =
         not na(activeAutoTarget) and
         activeAutoTarget < entryPrice and
         (effectiveAutoTargetMinDistancePct <= 0.0 or activeAutoTarget <= maximumAutoTarget)

    orderBlockStop =
         not na(activeOrderBlockTop) and activeOrderBlockTop > entryPrice ?
         activeOrderBlockTop * (1.0 + bufferMult) :
         percentStop

    orderBlockTarget =
         autoTargetReady ?
         activeAutoTarget :
         percentTarget

    activeStop :=
         exitMode == "订单块自动" ?
         orderBlockStop :
         percentStop

    activeTarget :=
         exitMode == "订单块自动" ?
         orderBlockTarget :
         percentTarget

// =============================================================================
// 订单块破位止损在成交后的下一次正常脚本计算时生效；止盈和普通止损在达到最短持仓时间后生效。
// 多单：价格跌破入场绿色订单块下沿外侧止损。
// 空单：价格突破入场红色订单块上沿外侧止损。
// =============================================================================

float immediateLongOrderBlockStop =
     enableImmediateOrderBlockStop and
     strategy.position_size > 0 and
     not na(activeOrderBlockBottom) and
     activeOrderBlockBottom < strategy.position_avg_price ?
     activeOrderBlockBottom * (1.0 - bufferMult) :
     na

float immediateShortOrderBlockStop =
     enableImmediateOrderBlockStop and
     strategy.position_size < 0 and
     not na(activeOrderBlockTop) and
     activeOrderBlockTop > strategy.position_avg_price ?
     activeOrderBlockTop * (1.0 + bufferMult) :
     na

float effectiveLongExitStop = na
float effectiveShortExitStop = na
float effectiveLongExitTarget = na
float effectiveShortExitTarget = na
bool longOrderBlockStopControlsExit = false
bool shortOrderBlockStopControlsExit = false

if strategy.position_size > 0
    if minimumHoldCompleted
        if not na(activeStop) and not na(immediateLongOrderBlockStop)
            effectiveLongExitStop := math.max(activeStop, immediateLongOrderBlockStop)
            longOrderBlockStopControlsExit := immediateLongOrderBlockStop >= activeStop
        else if not na(activeStop)
            effectiveLongExitStop := activeStop
        else
            effectiveLongExitStop := immediateLongOrderBlockStop
            longOrderBlockStopControlsExit := not na(immediateLongOrderBlockStop)

        effectiveLongExitTarget := activeTarget
    else
        effectiveLongExitStop := immediateLongOrderBlockStop
        longOrderBlockStopControlsExit := not na(immediateLongOrderBlockStop)

if strategy.position_size < 0
    if minimumHoldCompleted
        if not na(activeStop) and not na(immediateShortOrderBlockStop)
            effectiveShortExitStop := math.min(activeStop, immediateShortOrderBlockStop)
            shortOrderBlockStopControlsExit := immediateShortOrderBlockStop <= activeStop
        else if not na(activeStop)
            effectiveShortExitStop := activeStop
        else
            effectiveShortExitStop := immediateShortOrderBlockStop
            shortOrderBlockStopControlsExit := not na(immediateShortOrderBlockStop)

        effectiveShortExitTarget := activeTarget
    else
        effectiveShortExitStop := immediateShortOrderBlockStop
        shortOrderBlockStopControlsExit := not na(immediateShortOrderBlockStop)

if strategy.position_size > 0 and
   (not na(effectiveLongExitStop) or not na(effectiveLongExitTarget))

    strategy.exit(
         id = "多单止盈止损",
         from_entry = "做多",
         stop = effectiveLongExitStop,
         limit = effectiveLongExitTarget,
         comment = TVBOT_EXIT_LONG_COMMENT,
         comment_profit = "多单止盈",
         comment_loss = longOrderBlockStopControlsExit ? "多单订单块破位止损" : "多单止损",
         alert_message = TVBOT_EXIT_LONG_COMMENT,
         alert_profit = TVBOT_TP_LONG_INTENT,
         alert_loss = TVBOT_SL_LONG_INTENT,
         disable_alert = not enableTvbotAlert)

if strategy.position_size < 0 and
   (not na(effectiveShortExitStop) or not na(effectiveShortExitTarget))

    strategy.exit(
         id = "空单止盈止损",
         from_entry = "做空",
         stop = effectiveShortExitStop,
         limit = effectiveShortExitTarget,
         comment = TVBOT_EXIT_SHORT_COMMENT,
         comment_profit = "空单止盈",
         comment_loss = shortOrderBlockStopControlsExit ? "空单订单块破位止损" : "空单止损",
         alert_message = TVBOT_EXIT_SHORT_COMMENT,
         alert_profit = TVBOT_TP_SHORT_INTENT,
         alert_loss = TVBOT_SL_SHORT_INTENT,
         disable_alert = not enableTvbotAlert)

// =============================================================================
// 任一止盈或止损成交后启动固定6小时冷静期。
// 本策略所有平仓均由上方两条strategy.exit()的止盈止损订单完成。
// =============================================================================

if strategy.closedtrades > lastProcessedClosedTrade
    lastTradeIndex =
         strategy.closedtrades - 1

    closedExitTime =
         strategy.closedtrades.exit_time(lastTradeIndex)

    cooldownStartTime =
         na(closedExitTime) ? time : closedExitTime

    exitCooldownTriggeredThisBar := true
    cooldownUntil :=
         cooldownStartTime + cooldownMilliseconds

    strategy.cancel_all()

    lastProcessedClosedTrade :=
         strategy.closedtrades

if positionClosed
    activeStop := na
    activeTarget := na
    activeOrderBlockTop := na
    activeOrderBlockBottom := na
    activeEntryVrvpVal := na
    activeEntryVrvpVah := na
    activeAutoTarget := na

// =============================================================================
// FVG 50%显示线
// =============================================================================

var line fvgMidDisplayLine = na
var int displayedFvgBar = na

fvgDisplayColor =
     fvgDir == 1 ?
     color.new(color.lime, 0) :
     color.new(color.red, 0)

if showFvg and not na(fvgMid) and not na(fvgBar)
    if na(fvgMidDisplayLine) or displayedFvgBar != fvgBar
        if not na(fvgMidDisplayLine)
            line.delete(fvgMidDisplayLine)

        fvgMidDisplayLine := line.new(
             x1 = fvgBar,
             y1 = fvgMid,
             x2 = bar_index,
             y2 = fvgMid,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = fvgDisplayColor,
             width = 2)

        displayedFvgBar := fvgBar
    else
        line.set_x2(fvgMidDisplayLine, bar_index)
        line.set_y1(fvgMidDisplayLine, fvgMid)
        line.set_y2(fvgMidDisplayLine, fvgMid)
        line.set_color(fvgMidDisplayLine, fvgDisplayColor)
else
    if not na(fvgMidDisplayLine)
        line.delete(fvgMidDisplayLine)
        fvgMidDisplayLine := na
        displayedFvgBar := na

// =============================================================================
// 订单块开仓信号
// =============================================================================

plotshape(
     bullObStackLongSignalThisBar and validLongObCount == 1,
     title = "1个绿色订单块开多信号",
     style = shape.labelup,
     text = "绿1开多信号",
     color = color.new(color.lime, 0),
     textcolor = color.black,
     location = location.belowbar,
     size = size.small)

plotshape(
     bullObStackLongSignalThisBar and validLongObCount == 2,
     title = "2个绿色订单块开多信号",
     style = shape.labelup,
     text = "绿2开多信号",
     color = color.new(color.lime, 0),
     textcolor = color.black,
     location = location.belowbar,
     size = size.small)

plotshape(
     bullObStackLongSignalThisBar and validLongObCount == 3,
     title = "3个绿色订单块开多信号",
     style = shape.labelup,
     text = "绿3开多信号",
     color = color.new(color.lime, 0),
     textcolor = color.black,
     location = location.belowbar,
     size = size.small)

plotshape(
     bullObStackLongSignalThisBar and validLongObCount == 4,
     title = "4个绿色订单块开多信号",
     style = shape.labelup,
     text = "绿4开多信号",
     color = color.new(color.lime, 0),
     textcolor = color.black,
     location = location.belowbar,
     size = size.small)

plotshape(
     bearObStackShortSignalThisBar and validShortObCount == 1,
     title = "1个红色订单块开空信号",
     style = shape.labeldown,
     text = "红1开空信号",
     color = color.new(color.red, 0),
     textcolor = color.white,
     location = location.abovebar,
     size = size.small)

plotshape(
     bearObStackShortSignalThisBar and validShortObCount == 2,
     title = "2个红色订单块开空信号",
     style = shape.labeldown,
     text = "红2开空信号",
     color = color.new(color.red, 0),
     textcolor = color.white,
     location = location.abovebar,
     size = size.small)

plotshape(
     bearObStackShortSignalThisBar and validShortObCount == 3,
     title = "3个红色订单块开空信号",
     style = shape.labeldown,
     text = "红3开空信号",
     color = color.new(color.red, 0),
     textcolor = color.white,
     location = location.abovebar,
     size = size.small)

plotshape(
     bearObStackShortSignalThisBar and validShortObCount == 4,
     title = "4个红色订单块开空信号",
     style = shape.labeldown,
     text = "红4开空信号",
     color = color.new(color.red, 0),
     textcolor = color.white,
     location = location.abovebar,
     size = size.small)

// =============================================================================
// 止盈止损线
// =============================================================================

var line stopReferenceLine = na
var line targetReferenceLine = na

stopReferenceColor =
     minimumHoldCompleted ?
     color.new(stopLineColor, 0) :
     color.new(stopLineColor, 70)

targetReferenceColor =
     minimumHoldCompleted ?
     color.new(targetLineColor, 0) :
     color.new(targetLineColor, 70)

float displayedExitStop =
     strategy.position_size > 0 ? effectiveLongExitStop :
     strategy.position_size < 0 ? effectiveShortExitStop :
     na

float displayedExitTarget =
     strategy.position_size > 0 ? effectiveLongExitTarget :
     strategy.position_size < 0 ? effectiveShortExitTarget :
     na

canDrawReferenceLevels =
     showLevels and
     hasOpenTrade and
     not na(actualEntryBarIndex) and
     (not na(displayedExitStop) or not na(displayedExitTarget))

if canDrawReferenceLevels
    if not na(displayedExitStop)
        if na(stopReferenceLine)
            stopReferenceLine := line.new(
                 x1 = actualEntryBarIndex,
                 y1 = displayedExitStop,
                 x2 = bar_index,
                 y2 = displayedExitStop,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = stopReferenceColor,
                 width = 2)
        else
            line.set_x1(stopReferenceLine, actualEntryBarIndex)
            line.set_x2(stopReferenceLine, bar_index)
            line.set_y1(stopReferenceLine, displayedExitStop)
            line.set_y2(stopReferenceLine, displayedExitStop)
            line.set_color(stopReferenceLine, stopReferenceColor)
    else if not na(stopReferenceLine)
        line.delete(stopReferenceLine)
        stopReferenceLine := na

    if not na(displayedExitTarget)
        if na(targetReferenceLine)
            targetReferenceLine := line.new(
                 x1 = actualEntryBarIndex,
                 y1 = displayedExitTarget,
                 x2 = bar_index,
                 y2 = displayedExitTarget,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = targetReferenceColor,
                 width = 2)
        else
            line.set_x1(targetReferenceLine, actualEntryBarIndex)
            line.set_x2(targetReferenceLine, bar_index)
            line.set_y1(targetReferenceLine, displayedExitTarget)
            line.set_y2(targetReferenceLine, displayedExitTarget)
            line.set_color(targetReferenceLine, targetReferenceColor)
    else if not na(targetReferenceLine)
        line.delete(targetReferenceLine)
        targetReferenceLine := na
else
    if not na(stopReferenceLine)
        line.delete(stopReferenceLine)
        stopReferenceLine := na

    if not na(targetReferenceLine)
        line.delete(targetReferenceLine)
        targetReferenceLine := na

// =============================================================================
// 持仓锁定与冷静期背景
// =============================================================================

statusBackground =
     showCooldownBackground and inCooldown ?
         color.new(color.gray, 82) :
     showHoldBackground and holdingLocked ?
         color.new(color.orange, 90) :
         na

bgcolor(
     statusBackground,
     title = "持仓锁定与冷静期背景")

// =============================================================================
// 状态标签
// =============================================================================

var label statusLabel = na

if barstate.islast
    if not na(statusLabel)
        label.delete(statusLabel)
        statusLabel := na

    if showStatusLabel and holdingLocked
        remainingHoldMilliseconds =
             math.max(
                 actualEntryTime + minHoldMilliseconds - time,
                 0)

        remainingHoldMinutes =
             remainingHoldMilliseconds / 60000.0

        bool immediateStructureStopActive =
             not na(effectiveLongExitStop) or
             not na(effectiveShortExitStop)

        holdText =
             "最短持仓锁定中\n" +
             "剩余约 " +
             str.tostring(remainingHoldMinutes, "#") +
             " 分钟\n" +
             (immediateStructureStopActive ?
                 "订单块破位止损已启用，止盈尚未启用" :
                 "当前无止盈止损订单")

        statusLabel := label.new(
             x = bar_index,
             y = high,
             text = holdText,
             style = label.style_label_down,
             color = color.new(color.orange, 15),
             textcolor = color.white,
             size = size.small)

    else if showStatusLabel and inCooldown
        remainingCooldownMilliseconds =
             cooldownUntil - time

        remainingCooldownHours =
             remainingCooldownMilliseconds /
             float(hourMilliseconds)

        cooldownText =
             "止盈止损冷静期\n剩余约 " +
             str.tostring(remainingCooldownHours, "#.0") +
             " 小时"

        statusLabel := label.new(
             x = bar_index,
             y = high,
             text = cooldownText,
             style = label.style_label_down,
             color = color.new(color.gray, 20),
             textcolor = color.white,
             size = size.small)

// =============================================================================
// 报警条件
// 实际自动下单仍建议创建“仅订单执行”策略报警；开仓消息为entry_long / entry_short。
// =============================================================================

alertcondition(
     bullObStackLongSignalThisBar,
     title = "订单块测试版开多信号",
     message = "订单块测试版开多信号：按当前交易频率模式，1H绿色订单块达到生效数量并逐级抬高，价格突破最新绿色订单块上沿；启用回踩确认时，价格突破后回踩并重新向上收盘。")

alertcondition(
     bearObStackShortSignalThisBar,
     title = "订单块测试版开空信号",
     message = "订单块测试版开空信号：按当前交易频率模式，1H红色订单块达到生效数量并逐级下移，价格跌破最新红色订单块下沿；启用回踩确认时，价格跌破后回踩并重新向下收盘。")

alertcondition(
     exitCooldownTriggeredThisBar,
     title = "订单块测试版止盈止损进入冷静期",
     message = "订单块测试策略发生止盈或止损平仓，已经进入固定6小时冷静期。")

// =============================================================================
// 今日08:00起算的VRVP右侧小型成交量分布绘图
// =============================================================================

var array<box> vrvpProfileBoxes = array.new_box()
var line vrvpValLine = na
var line vrvpVahLine = na

if barstate.islast
    float vrvpRowHeight =
         not na(vrvpProfileHigh) and not na(vrvpProfileLow) ?
         (vrvpProfileHigh - vrvpProfileLow) / vrvpRowSize :
         na

    bool canDrawVrvp =
         enableVrvp and
         vrvpLookbackBars > 0 and
         not na(vrvpRowHeight) and
         vrvpRowHeight > 0 and
         array.size(vrvpRowVolumes) == vrvpRowSize

    if not canDrawVrvp
        while array.size(vrvpProfileBoxes) > 0
            box.delete(array.pop(vrvpProfileBoxes))

        if not na(vrvpValLine)
            line.delete(vrvpValLine)
            vrvpValLine := na

        if not na(vrvpVahLine)
            line.delete(vrvpVahLine)
            vrvpVahLine := na

    else
        int profileRight =
             bar_index + vrvpOffset

        int profileAreaLeft =
             math.max(
                 0,
                 profileRight - vrvpBarWidth)

        // VAH与VAL线仅显示在右侧成交量分布区域，不再横跨整段历史K线。
        if vrvpShowValueArea and
           not na(vrvpVal) and
           not na(vrvpVah)

            if na(vrvpValLine)
                vrvpValLine := line.new(
                     x1 = profileAreaLeft,
                     y1 = vrvpVal,
                     x2 = profileRight,
                     y2 = vrvpVal,
                     xloc = xloc.bar_index,
                     extend = extend.none,
                     color = vrvpValColor,
                     width = 2)
            else
                line.set_xy1(vrvpValLine, profileAreaLeft, vrvpVal)
                line.set_xy2(vrvpValLine, profileRight, vrvpVal)
                line.set_color(vrvpValLine, vrvpValColor)
                line.set_width(vrvpValLine, 2)

            if na(vrvpVahLine)
                vrvpVahLine := line.new(
                     x1 = profileAreaLeft,
                     y1 = vrvpVah,
                     x2 = profileRight,
                     y2 = vrvpVah,
                     xloc = xloc.bar_index,
                     extend = extend.none,
                     color = vrvpVahColor,
                     width = 2)
            else
                line.set_xy1(vrvpVahLine, profileAreaLeft, vrvpVah)
                line.set_xy2(vrvpVahLine, profileRight, vrvpVah)
                line.set_color(vrvpVahLine, vrvpVahColor)
                line.set_width(vrvpVahLine, 2)
        else
            if not na(vrvpValLine)
                line.delete(vrvpValLine)
                vrvpValLine := na

            if not na(vrvpVahLine)
                line.delete(vrvpVahLine)
                vrvpVahLine := na

        float maximumDrawingVolume =
             array.max(vrvpRowVolumes)

        if maximumDrawingVolume > 0
            // 对缓存后的价格档成交量进行排序。
            // 直接取得成交量最大的3档，不重新扫描历史K线。
            array<int> sortedDrawingRows =
                 array.sort_indices(
                     vrvpRowVolumes,
                     order.descending)

            int topDrawingRow1 =
                 array.get(sortedDrawingRows, 0)

            int topDrawingRow2 =
                 array.get(sortedDrawingRows, 1)

            int topDrawingRow3 =
                 array.get(sortedDrawingRows, 2)

            int valRowIndex =
                 not na(vrvpVal) ?
                 int(math.floor(
                     (vrvpVal - vrvpProfileLow) /
                     vrvpRowHeight)) :
                 -1

            // VAH是值区最后一档的上边界，因此映射回行号时需要减1。
            int vahRowIndex =
                 not na(vrvpVah) ?
                 int(math.round(
                     (vrvpVah - vrvpProfileLow) /
                     vrvpRowHeight)) - 1 :
                 -1

            if valRowIndex >= 0
                valRowIndex :=
                     math.max(
                         0,
                         math.min(vrvpRowSize - 1, valRowIndex))

            if vahRowIndex >= 0
                vahRowIndex :=
                     math.max(
                         0,
                         math.min(vrvpRowSize - 1, vahRowIndex))

            color outsideValueAreaColor =
                 color.new(
                     color.white,
                     vrvpOutsideTransparency)

            color insideValueAreaColor =
                 color.new(
                     color.white,
                     vrvpInsideTransparency)

            // 最大3档成交量固定使用0透明度。
            color topVolumeColor =
                 color.new(
                     vrvpTopVolumeColor,
                     0)

            while array.size(vrvpProfileBoxes) > vrvpRowSize
                box.delete(array.pop(vrvpProfileBoxes))
            for rowIndex = 0 to vrvpRowSize - 1
                float rowBottom =
                     vrvpProfileLow +
                     rowIndex * vrvpRowHeight

                float rowTop =
                     rowBottom + vrvpRowHeight

                float currentRowVolume =
                     array.get(vrvpRowVolumes, rowIndex)

                int rowWidth =
                     currentRowVolume > 0 ?
                     math.max(
                         1,
                         int(math.round(
                             currentRowVolume /
                             maximumDrawingVolume *
                             vrvpBarWidth))) :
                     1

                int profileLeft =
                     profileRight - rowWidth

                bool isTopVolumeRow =
                     currentRowVolume > 0 and
                     (rowIndex == topDrawingRow1 or
                      rowIndex == topDrawingRow2 or
                      rowIndex == topDrawingRow3)

                bool isInsideValueArea =
                     vrvpShowValueArea and
                     valRowIndex >= 0 and
                     vahRowIndex >= 0 and
                     rowIndex >= valRowIndex and
                     rowIndex <= vahRowIndex

                // 显示优先级：
                // 1. 成交量最大的3档：紫色，透明度0。
                // 2. VAL至VAH之间：白色，默认透明度50%。
                // 3. VAL下方与VAH上方：白色，默认透明度0。
                color rowColor =
                     isTopVolumeRow ?
                     topVolumeColor :
                     isInsideValueArea ?
                     insideValueAreaColor :
                     outsideValueAreaColor

                box currentProfileBox = na

                if rowIndex < array.size(vrvpProfileBoxes)
                    currentProfileBox :=
                         array.get(vrvpProfileBoxes, rowIndex)
                else
                    currentProfileBox := box.new(
                         left = profileLeft,
                         top = rowTop,
                         right = profileRight,
                         bottom = rowBottom,
                         xloc = xloc.bar_index,
                         extend = extend.none,
                         bgcolor = rowColor,
                         border_color = rowColor,
                         border_width = 0)

                    array.push(
                         vrvpProfileBoxes,
                         currentProfileBox)

                // 重用box对象，仅更新坐标和颜色。
                box.set_left(currentProfileBox, profileLeft)
                box.set_right(currentProfileBox, profileRight)
                box.set_top(currentProfileBox, rowTop)
                box.set_bottom(currentProfileBox, rowBottom)
                box.set_bgcolor(currentProfileBox, rowColor)
                box.set_border_color(currentProfileBox, rowColor)
                box.set_border_width(currentProfileBox, 0)

        else
            while array.size(vrvpProfileBoxes) > 0
                box.delete(array.pop(vrvpProfileBoxes))
