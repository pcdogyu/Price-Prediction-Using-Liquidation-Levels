//@version=6
// SMC Order Block Only Test Strategy version: 4.0.26
// v4.0.26：止盈和止损订单执行均向tvbot发送明确平仓意图；任一止盈止损成交后从实际退出时间起固定冷静6小时，禁止再次开仓。
// v4.0.25：关闭calc_on_order_fills，避免TradingView因成交后历史K线内重算提示“可能使用前瞻偏见”。止盈止损不再于历史回测的入场成交瞬间同K线创建，而是在下一次正常脚本计算后创建。
// v4.0.24：新增自动止盈最小距离保护。中频模式下自动目标距离开仓价不足1%时不再使用贴近的订单块/值区目标，回退到备用百分比止盈，避免空单开仓后因目标过近立刻止盈。
// v4.0.23：新增交易频率模式，默认“中频”。中频模式自动放宽为1个1H订单块、1H结构长度2、关闭1H/FVG/反向间距过滤、追价距离至少5%、最短持仓1小时、止损冷静期2小时，并默认不使用禁开仓窗口，用于把订单频率提高到日均1-2笔级别。
// v4.0.22：TEST版订单块恢复固定1H结构来源；新增1H结构方向过滤与当前周期FVG 50%回补过滤，使订单块信号先通过1H BOS/偏向与FVG确认后再开仓。
// v4.0.21：新增反向订单块最小间距过滤（默认1%）。红色空单订单块与下方最近绿色多单订单块相邻边界距离不足阈值时，同时忽略对应红绿订单块的入场信号来源，但保留图形显示和自动目标搜索。
// v4.0.20：大均线交易方式下拉改为“关闭、正向交易、反向交易”；正向交易为均线上方只开多、均线下方只开空，反向交易为均线上方只开空、均线下方只开多，关闭时不限制订单块信号。
// v4.0.19：调整反向订单块截断规则：旧订单块向右延伸时，只有与新出现的反向订单块在时间区间和价格区间实际接触/重叠，才停止延伸并从后续共振与自动目标计算中移除；未接触的反向订单块不会截断。
// v4.0.18：新增可调大周期方向EMA（默认200，可设100/200等）及方向模式：关闭、正向、反向。正向模式为价格在EMA上方只做多、下方只做空；反向模式为EMA上方只做空、下方只做多。EMA过滤同时作用于直接突破与回踩确认入场。
// v4.0.17：根据回测结果将“突破后回踩确认”默认关闭，恢复订单块边界直接突破开仓；回踩确认功能仍保留为可选实验参数，避免默认过滤掉趋势行情中的有效机会。
// v4.0.16：新增订单块突破后的回踩确认开仓。默认先等待价格突破最新订单块边界，再在限定K线内回踩边界并以同方向K线重新收回后入场，用于过滤一次性假突破、提高胜率；可关闭以恢复原来的直接突破入场。
// v4.0.15：新增两个禁止下单窗口：中国时间04:30-09:00，以及纽约时间09:30-10:30（自动处理美国夏令时）；新增订单块外沿即时结构止损，多单跌破入场绿色订单块下沿、空单突破入场红色订单块上沿立即止损，不受最短持仓时间限制。
// v4.0.14：按照指定默认值，将最短持仓时间改为4小时、止损后冷静期改为12小时；移除全部订单块BOS K线填充输入参数及绘图逻辑。
// v4.0.13：区分订单块开仓信号、实际成交、止盈与止损标签；红色信号改为“开空”，绿色信号改为“开多”，策略离场按实际原因显示“多/空单止盈”或“多/空单止损”，Webhook意图保持不变。
// v4.0.12：新增反向订单块截断逻辑；新绿色订单块出现时终止仍在延伸的红色订单块，新红色订单块出现时终止仍在延伸的绿色订单块，并同步移除其后续共振与自动目标计算资格。
// v4.0.11：移除固定1小时结构信号与“1H结构长度”参数；订单块改为直接使用当前图表周期结构生成，结构长度固定为3，图表和参数中不再显示1H信号。
// v4.0.10：订单块数量改为单一数字参数，可直接选择1、2、3或4；移除四个独立档位开关与分档追价距离，买卖双方统一使用所选数量和统一最大追价距离。
// v4.0.9：订单块信号测试版。移除DA趋势、正向/反向模式、FVG、原有订单块等待和其他开仓过滤；多空方向只由1/2/3/4个订单块共振信号决定。保留订单块生成/失效、自动止盈止损、最短持仓和止损冷静期。
// v4.0.8：订单块共振扩展为多空双向；三个连续下移红色订单块可触发卖出，并增加1/2/3/4个订单块档位、各档启用开关、追价距离、排列间距和统计保留数量参数。
// v4.0.7：增加“多绿色订单块共振买入”：最近有效绿色订单块达到设定数量并逐级抬高，价格站上最新绿块上沿且未超出追价距离时，独立触发一次实际多单。
// v4.0.6：订单块自动止盈增加当日值区优先规则：多单在VAL附近成交时止盈锁定VAH，空单在VAH附近成交时止盈锁定VAL；否则继续使用对向订单块，最后回退备用百分比。
// v4.0.5：VRVP仅保留右侧当日小型成交量分布，移除横跨图表的Top3密集区块；新增订单块自动止盈止损：多单止盈取上方最近红色订单块下沿，空单止盈取下方最近绿色订单块上沿，止损取入场订单块外侧。
// v4.0.4：移除交易频率档位，1H结构长度、止损冷静期和订单块等待时间均直接使用输入值。
// v4.0.3：最短持仓时间最低固定为1小时，交易频率档位不再缩短最短持仓。
// v4.0.2：增加交易频率档位；默认“提高”，自动缩短1H结构长度、使用FVG边缘触发、降低最短持仓/止损冷静期/订单块等待时间。
// v4.0.1：DA趋势过滤默认关闭。
// v4.0.0：升级主版本；订单区块矩形默认显示，水平偏移默认-300分钟，显示长度默认4320分钟。
// v3.0.7：增加订单块入场过滤；多单需到绿色订单块顶部下方，空单需到红色订单块底部上方，超时未到则忽略。
// v3.0.6：增加DA趋势过滤开关，关闭后不再按1H EMA100/EMA200上下方限制开仓方向。
// v3.0.5：移除VAL/VAH开仓过滤，恢复不受值区限制的开仓逻辑。
// v3.0.4：VAL/VAH开仓过滤增加可调缓冲，默认放宽为值区宽度10%。
// v3.0.3：增加VRVP值区开仓过滤，只在VAL下方开多，只在VAH上方开空。
// v3.0.2：tvbot订单成交消息改为entry_long/entry_short/exit_long/exit_short，避免平仓成交buy/sell被误识别为反向开仓。
// v3.0.1：看涨与看跌订单区块使用独立填充透明度，看跌订单区块默认80%。
// v3.0.0：FVG回补信号确认后使用strategy市价开仓，回测在下一根K线开盘成交。
// Version rule: every future code change should increase the patch version by 0.0.1.

const string SCRIPT_VERSION = "4.0.26"
const string STRUCTURE_TIMEFRAME = "60"
const int DEFAULT_ORDER_BLOCK_STRUCTURE_LENGTH = 3

strategy(
     title = "SMC Order Block Only TEST Strategy v" + SCRIPT_VERSION,
     shorttitle = "OB Only TEST v" + SCRIPT_VERSION,
     overlay = true,
     max_bars_back = 5000,
     pyramiding = 0,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     // 市价开仓严格使用下一根K线开盘价，不额外叠加模拟滑点。
     slippage = 0,
     backtest_fill_limits_assumption = 1,

     // VRVP在实时K线内随成交量变化即时刷新。
     // BOS、订单块失效和订单块开仓信号均使用barstate.isconfirmed，避免未收盘信号反复变化。
     calc_on_order_fills = false,
     calc_on_every_tick = true,

     // 市价开仓订单不在信号K线收盘tick成交，回测使用下一根K线开盘价。
     process_orders_on_close = false,

     // 关闭TradingView模拟器的保证金强制清算。
     // 避免出现非脚本止损导致的Margin call。
     margin_long = 0,
     margin_short = 0,

     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500)

// =============================================================================
// 00. 交易频率模式
// =============================================================================

tradeFrequencyMode = input.string(
     "中频",
     "交易频率模式",
     options = ["中频", "保守", "手动"],
     tooltip = "中频：默认面向每天1-2笔级别，自动放宽关键过滤。\n保守：锁定4.0.22风格的低频过滤。\n手动：完全使用下面各项参数。",
     group = "00. 交易频率模式")

bool mediumFrequencyMode = tradeFrequencyMode == "中频"
bool conservativeFrequencyMode = tradeFrequencyMode == "保守"

// =============================================================================
// 01. 1H订单块结构
// TEST版固定使用1小时BOS与订单块，避免低周期图表生成过密订单块。
// =============================================================================

htfStructureLength = input.int(
     DEFAULT_ORDER_BLOCK_STRUCTURE_LENGTH,
     "1H结构长度",
     minval = 1,
     maxval = 20,
     tooltip = "固定使用1小时BOS与订单块。中频模式自动使用2，保守模式使用3，手动模式使用此参数。",
     group = "01. 1H结构")

int effectiveHtfStructureLength =
     mediumFrequencyMode ? 2 :
     conservativeFrequencyMode ? DEFAULT_ORDER_BLOCK_STRUCTURE_LENGTH :
     htfStructureLength

// =============================================================================
// 02. 测试版交易方向
// 订单块仍是唯一的开仓信号来源；大均线仅用于限制允许开仓的方向。
// =============================================================================

enableLong = input.bool(
     true,
     "允许订单块信号做多",
     group = "02. 测试版交易方向")

enableShort = input.bool(
     true,
     "允许订单块信号做空",
     group = "02. 测试版交易方向")

// =============================================================================
// 02A. 大均线方向过滤
// =============================================================================

majorEmaLength = input.int(
     200,
     "大均线EMA周期",
     minval = 1,
     maxval = 1000,
     tooltip = "默认200。可改为100、200或其他周期；EMA直接使用当前图表周期的收盘价计算。",
     group = "02A. 大均线方向过滤")

majorEmaTradeMode = input.string(
     "关闭",
     "大均线交易方式",
     options = ["关闭", "正向交易", "反向交易"],
     tooltip = "关闭：大均线不限制订单块信号。\n正向交易：均线上方只开多单，均线下方只开空单。\n反向交易：均线上方只开空单，均线下方只开多单。\n价格刚好等于EMA时不提交新订单。",
     group = "02A. 大均线方向过滤")

showMajorEma = input.bool(
     true,
     "显示大均线EMA",
     group = "02A. 大均线方向过滤")

majorEmaColor = input.color(
     color.blue,
     "大均线EMA颜色",
     group = "02A. 大均线方向过滤")

majorEmaWidth = input.int(
     2,
     "大均线EMA宽度",
     minval = 1,
     maxval = 5,
     group = "02A. 大均线方向过滤")

float majorEma = ta.ema(close, majorEmaLength)

plot(
     showMajorEma ? majorEma : na,
     title = "大均线EMA",
     color = majorEmaColor,
     linewidth = majorEmaWidth)

bool priceAboveMajorEma = not na(majorEma) and close > majorEma
bool priceBelowMajorEma = not na(majorEma) and close < majorEma
bool majorEmaFilterDisabled = majorEmaTradeMode == "关闭"
bool majorEmaForwardMode = majorEmaTradeMode == "正向交易" or majorEmaTradeMode == "正向"
bool majorEmaReverseMode = majorEmaTradeMode == "反向交易" or majorEmaTradeMode == "反向"

bool majorEmaLongAllowed =
     majorEmaFilterDisabled or
     (majorEmaForwardMode and priceAboveMajorEma) or
     (majorEmaReverseMode and priceBelowMajorEma)

bool majorEmaShortAllowed =
     majorEmaFilterDisabled or
     (majorEmaForwardMode and priceBelowMajorEma) or
     (majorEmaReverseMode and priceAboveMajorEma)

// =============================================================================
// 03. 订单块唯一开仓信号
// =============================================================================

enableBullObStackBuy = input.bool(
     true,
     "启用绿色订单块共振买入",
     tooltip = "测试版唯一多单信号：最近有效绿色订单块达到设定数量、按时间先后逐级抬高，且收盘站上最新绿色订单块上沿时触发实际多单。",
     group = "03. 订单块信号")

enableBearObStackSell = input.bool(
     true,
     "启用红色订单块共振卖出",
     tooltip = "测试版唯一空单信号：最近有效红色订单块达到设定数量、按时间先后逐级下移，且收盘跌破最新红色订单块下沿时触发实际空单。默认设置为3个红色订单块。",
     group = "03. 订单块信号")

obStackHistoryCount = input.int(
     12,
     "共振统计保留的最近订单块总数",
     minval = 4,
     maxval = 50,
     tooltip = "红绿订单块合计保留数量，仅用于入场过滤、自动目标和共振统计；图表显示数量仍由“最近订单区块计算数量”控制。为了能在红绿交错时识别所选数量的同向订单块，默认保留12个。",
     group = "03. 订单块信号")

obStackMinStepPct = input.float(
     0.0,
     "相邻订单块中点最小递进幅度 %",
     minval = 0.0,
     maxval = 20.0,
     step = 0.1,
     tooltip = "0表示只要求严格抬高或下移。设置为1表示：做多时较新的绿色订单块中点至少比前一个高1%；做空时较新的红色订单块中点至少比前一个低1%。",
     group = "03. 订单块信号")

obStackRequiredCount = input.int(
     3,
     "订单块数量（1-4）",
     minval = 1,
     maxval = 4,
     step = 1,
     tooltip = "直接输入1、2、3或4。中频模式自动使用1，保守模式使用3，手动模式使用此参数。",
     group = "03A. 订单块数量参数")

obStackMaxDistancePct = input.float(
     2.0,
     "最大追价距离 %",
     minval = 0.0,
     maxval = 20.0,
     step = 0.1,
     tooltip = "多单为收盘价高出最新绿色订单块上沿的最大距离；空单为收盘价低于最新红色订单块下沿的最大距离。中频模式至少使用5%，保守模式使用2%，手动模式使用此参数。",
     group = "03A. 订单块数量参数")

oppositeObMinGapPct = input.float(
     1.0,
     "反向订单块最小间距 %",
     minval = 0.0,
     maxval = 20.0,
     step = 0.1,
     tooltip = "0表示关闭该过滤。中频模式自动关闭，保守模式使用1%，手动模式使用此参数。",
     group = "03A. 订单块数量参数")

int effectiveObStackRequiredCount =
     mediumFrequencyMode ? 1 :
     conservativeFrequencyMode ? 3 :
     obStackRequiredCount

float effectiveObStackMaxDistancePct =
     mediumFrequencyMode ? math.max(obStackMaxDistancePct, 5.0) :
     conservativeFrequencyMode ? 2.0 :
     obStackMaxDistancePct

float effectiveOppositeObMinGapPct =
     mediumFrequencyMode ? 0.0 :
     conservativeFrequencyMode ? 1.0 :
     oppositeObMinGapPct

// =============================================================================
// 03A-1. FVG / 1H结构过滤
// =============================================================================

enableHtfStructureFilter = input.bool(
     true,
     "启用1H结构方向过滤",
     tooltip = "开启后，多单要求最新1H结构偏多，空单要求最新1H结构偏空。中频模式自动关闭，保守模式自动开启，手动模式使用此参数。",
     group = "03A-1. FVG / 1H结构过滤")

enableFvgFilter = input.bool(
     true,
     "启用FVG 50%回补过滤",
     tooltip = "开启后，多单要求最近看涨FVG的50%被回补触及，空单要求最近看跌FVG的50%被回补触及。中频模式自动关闭，保守模式自动开启，手动模式使用此参数。",
     group = "03A-1. FVG / 1H结构过滤")

bool effectiveHtfStructureFilterEnabled =
     mediumFrequencyMode ? false :
     conservativeFrequencyMode ? true :
     enableHtfStructureFilter

bool effectiveFvgFilterEnabled =
     mediumFrequencyMode ? false :
     conservativeFrequencyMode ? true :
     enableFvgFilter

// =============================================================================
// 03A-2. 订单块回踩确认（实验功能，默认关闭）
// 回测显示严格回踩会明显减少有效趋势机会，因此默认恢复直接突破开仓。
// =============================================================================

enableObRetestConfirmation = input.bool(
     false,
     "启用突破后回踩确认（实验）",
     tooltip = "默认关闭，直接使用订单块边界突破开仓。开启后，第一次突破只进入等待状态，随后必须回踩边界并重新向突破方向收盘才开仓；该模式可能提高个别行情的信号质量，但会显著减少趋势机会。",
     group = "03A-2. 订单块回踩确认")

obRetestWaitBars = input.int(
     8,
     "突破后最多等待K线数",
     minval = 1,
     maxval = 100,
     tooltip = "突破后等待回踩确认的最长K线数量。15分钟图默认8根约为2小时；超过后放弃该订单块信号，直到出现新的同向订单块。",
     group = "03A-2. 订单块回踩确认")

obRetestTolerancePct = input.float(
     20.0,
     "回踩边界容差（订单块高度%）",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     tooltip = "以最新订单块自身高度计算。多单回踩时，最低价进入绿色订单块上沿上方该容差范围即视为接近边界；空单反向计算。数值越小越严格、信号越少。",
     group = "03A-2. 订单块回踩确认")

obRetestRequireDirectionCandle = input.bool(
     true,
     "要求确认K线方向一致",
     tooltip = "开启后，多单回踩确认K线必须收阳，空单回踩确认K线必须收阴。通常可以提高胜率，但会减少交易次数。",
     group = "03A-2. 订单块回踩确认")

// =============================================================================
// 03B. 禁止下单时间
// 使用订单预计成交时间（信号K线的time_close）判断，避免信号在窗口前一根K线产生、却在禁止窗口内成交。
// =============================================================================

enableChinaNoTradeWindow = input.bool(
     true,
     "禁止中国时间04:30-09:00下单",
     tooltip = "开启后，中国时间每天04:30（含）至09:00（不含）禁止提交新的多单或空单。中频模式自动关闭，保守模式自动开启，手动模式使用此参数。",
     group = "03B. 禁止下单时间")

enableUsOpenNoTradeWindow = input.bool(
     true,
